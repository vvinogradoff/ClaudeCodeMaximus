<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TessynDesktop.ViewModels"
             xmlns:views="using:TessynDesktop.Views"
             xmlns:models="using:TessynDesktop.Models"
             xmlns:converters="using:TessynDesktop.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="TessynDesktop.Views.SessionView"
             x:Name="Root"
             x:DataType="vm:SessionViewModel">

    <UserControl.Styles>
        <!-- Favorite star toggle: grey/transparent when off, black-stroked gold when favorited -->
        <Style Selector="ToggleButton.fav Path">
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="Gray"/>
        </Style>
        <Style Selector="ToggleButton.fav:checked Path">
            <Setter Property="Fill" Value="Gold"/>
            <Setter Property="Stroke" Value="Black"/>
        </Style>
        <!-- Profile-actions label toggle: looks like the plain "Profile:" text label, no button chrome -->
        <Style Selector="ToggleButton.linklike">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="ToggleButton.linklike:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!--
          Compact command-bar selectors (~120px closed box, FR.12.22). Avalonia's ComboBox binds its
          dropdown Popup's width to the control's own width by default, which would clip a wide list
          (model IDs, profile names) down to 120px — override the named template parts (PART_Popup,
          PART_ItemsPresenter) back to auto/content width so the fly-out itself stays full-width.
        -->
        <Style Selector="ComboBox.cmxCompact">
            <Setter Property="Width" Value="120"/>
        </Style>
        <Style Selector="ComboBox.cmxCompact /template/ Popup#PART_Popup">
            <Setter Property="Width" Value="NaN"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style Selector="ComboBox.cmxCompact /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="Width" Value="NaN"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,5,120">

        <Border Grid.Row="0" Padding="12,6"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <ToggleButton DockPanel.Dock="Right"
                              IsChecked="{Binding IsClaudeSessionView}"
                              IsVisible="{Binding HasClaudeSession}"
                              Content="JSONL"
                              ToolTip.Tip="Switch between TessynDesktop session and Claude CLI session"
                              Padding="8,3" FontSize="11"
                              Margin="4,0,0,0"
                              VerticalAlignment="Center"/>
                <ToggleButton DockPanel.Dock="Right"
                              IsChecked="{Binding IsMarkdownMode}"
                              Content="MD"
                              ToolTip.Tip="Toggle markdown rendering"
                              Padding="8,3" FontSize="11"
                              VerticalAlignment="Center"/>
                <views:NativeTextBox DockPanel.Dock="Right"
                         x:Name="OutputSearchBox"
                         Watermark="Search output..."
                         Width="180" Margin="0,0,8,0"
                         Padding="6,3" FontSize="12"
                         VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding LocationDisplay}"
                               FontSize="11" Opacity="0.5"
                               IsVisible="{Binding LocationDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Name}"
                               FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="*,Auto">
            <Grid Grid.Row="0">
            <ScrollViewer x:Name="MessageScroller"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MessageList"
                              ItemsSource="{Binding Messages}"
                              Margin="0,4,0,4">
                    <ItemsControl.DataTemplates>
                        <DataTemplate x:DataType="vm:MessageEntryViewModel"
                                      x:CompileBindings="False">
                            <Panel>

                                <!-- User message: timestamp left, bubble right -->
                                <Grid IsVisible="{Binding IsUser}" Margin="0,4,8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,6,5">
                                        <TextBlock Text="{Binding FormattedDate}"
                                                   FontSize="9" Opacity="0.3"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding FormattedTime}"
                                                   FontSize="10" Opacity="0.35"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="10,7" CornerRadius="8"
                                            Background="{DynamicResource CmxUserBubbleBg}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,3">
                                                <TextBlock DockPanel.Dock="Left" Text="You" FontSize="11"
                                                           Foreground="{DynamicResource CmxUserBubbleFg}"
                                                           Opacity="0.6"/>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding ProfileName}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource CmxUserBubbleFg}"
                                                           Opacity="0.5"
                                                           HorizontalAlignment="Right"
                                                           IsVisible="{Binding HasProfileName}"/>
                                            </DockPanel>
                                            <views:HighlightTextBlock Text="{Binding Content}"
                                                                 HighlightTerm="{Binding DataContext.OutputSearchVm.ActiveSearchTerm, ElementName=Root}"
                                                                 IsCurrentMatch="{Binding IsCurrentSearchMatch}"
                                                                 TextWrapping="Wrap"
                                                                 Foreground="{DynamicResource CmxUserBubbleFg}"
                                                                 FontFamily="Cascadia Code,Consolas,monospace"
                                                                 FontSize="{Binding DataContext.UserFontSize, ElementName=Root}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Assistant message: text left, timestamp right -->
                                <Grid IsVisible="{Binding IsAssistant}" Margin="8,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding ModelLabel}"
                                                   IsVisible="{Binding HasModelLabel}"
                                                   FontSize="11" Opacity="0.45"
                                                   FontStyle="Italic"
                                                   Margin="0,0,0,4"/>
                                        <Panel>
                                            <views:MarkdownView
                                                IsVisible="{Binding DataContext.IsMarkdownMode, ElementName=Root}"
                                                Markdown="{Binding Content}"
                                                HighlightTerm="{Binding DataContext.OutputSearchVm.ActiveSearchTerm, ElementName=Root}"
                                                IsCurrentMatch="{Binding IsCurrentSearchMatch}"
                                                FontSize="{Binding DataContext.AssistantMarkdownFontSize, ElementName=Root}"/>
                                            <views:HighlightTextBlock
                                                IsVisible="{Binding !DataContext.IsMarkdownMode, ElementName=Root}"
                                                Text="{Binding Content}"
                                                HighlightTerm="{Binding DataContext.OutputSearchVm.ActiveSearchTerm, ElementName=Root}"
                                                IsCurrentMatch="{Binding IsCurrentSearchMatch}"
                                                TextWrapping="Wrap"
                                                FontFamily="Cascadia Code,Consolas,monospace"
                                                FontSize="{Binding DataContext.AssistantFontSize, ElementName=Root}"/>
                                        </Panel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Left"
                                                Margin="4,0,8,2">
                                        <TextBlock Text="{Binding FormattedTime}"
                                                   FontSize="10" Opacity="0.35"
                                                   HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>

                                <!-- System message -->
                                <Border IsVisible="{Binding IsSystem}" Margin="20,4,20,4" Padding="8,5" CornerRadius="4"
                                        Background="{DynamicResource CmxSystemBubbleBg}">
                                    <views:HighlightTextBlock Text="{Binding Content}"
                                                              HighlightTerm="{Binding DataContext.OutputSearchVm.ActiveSearchTerm, ElementName=Root}"
                                                              IsCurrentMatch="{Binding IsCurrentSearchMatch}"
                                                              TextWrapping="Wrap" FontSize="12" Opacity="0.7" FontStyle="Italic"/>
                                </Border>

                                <!-- Compaction separator -->
                                <StackPanel IsVisible="{Binding IsCompaction}" Margin="8,8,8,8" Orientation="Vertical" Spacing="2">
                                    <Separator/>
                                    <TextBlock Text="&#x2015; Context compacted above &#x2015;"
                                               HorizontalAlignment="Center" FontSize="11" Opacity="0.5" FontStyle="Italic"/>
                                    <Separator/>
                                </StackPanel>

                            </Panel>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </ScrollViewer>

            <!-- Search results overlay (FR.10.3) -->
            <Border x:Name="SearchOverlay"
                    IsVisible="{Binding OutputSearchVm.IsActive}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,16,0" Padding="10,5" CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="#CCCC00"
                    Background="#40FFFF00"
                    x:CompileBindings="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding OutputSearchVm.StatusText}"
                               VerticalAlignment="Center" FontSize="12"/>
                    <Button x:Name="SearchPrevBtn" Content="&lt;"
                            Padding="6,2" FontSize="11" MinWidth="0"
                            VerticalAlignment="Center"/>
                    <Button x:Name="SearchNextBtn" Content="&gt;"
                            Padding="6,2" FontSize="11" MinWidth="0"
                            VerticalAlignment="Center"/>
                    <Button x:Name="SearchCloseBtn" Content="X"
                            Padding="6,2" FontSize="11" MinWidth="0"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

            <!-- Thinking indicator (inside Row 1, below messages) -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        IsVisible="{Binding IsBusy}"
                        Margin="8,3,8,3"
                        Spacing="6">
                <TextBlock Text="Claude is thinking…"
                           FontStyle="Italic"
                           Opacity="0.5"
                           FontSize="13"/>
                <TextBlock Text="{Binding ThinkingDuration}"
                           FontStyle="Italic"
                           Opacity="0.5"
                           FontSize="13"
                           Foreground="#888888"/>
            </StackPanel>
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        IsVisible="{Binding IsExternallyActive}"
                        Margin="8,3,8,3"
                        Spacing="6"
                        x:CompileBindings="False">
                <Ellipse Width="8" Height="8" Fill="Orange" VerticalAlignment="Center"/>
                <TextBlock Text="Active in external terminal…"
                           FontStyle="Italic"
                           Opacity="0.5"
                           FontSize="13"/>
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Row="2" ResizeDirection="Rows"
                      Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>

        <Border Grid.Row="3" Padding="8" MinHeight="120"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Left column: Input area + Command bar -->
                <Grid Grid.Column="0" RowDefinitions="*,Auto">
                    <Panel Grid.Row="0">
                        <views:NativeTextBox x:Name="InputBox"
                                 Text="{Binding InputText}"
                                 AcceptsReturn="True"
                                 Watermark="Type a message... (Ctrl+Enter to send)  |  # symbol  ## file"
                                 TextWrapping="Wrap"
                                 FontFamily="Cascadia Code,Consolas,monospace"
                                 FontSize="{Binding InputFontSize}"
                                 Background="{DynamicResource CmxInputBg}"
                                 Foreground="{DynamicResource CmxInputFg}"/>
                        <Popup x:Name="AutocompletePopup"
                               PlacementTarget="{Binding ElementName=InputBox}"
                               Placement="Top"
                               IsOpen="{Binding AutocompleteVm.IsOpen, Mode=OneWay}"
                               IsLightDismissEnabled="False"
                               x:CompileBindings="False">
                            <views:AutocompletePopup DataContext="{Binding AutocompleteVm}"/>
                        </Popup>
                    </Panel>
                    <!-- Command bar (model selection) — below input, left of buttons -->
                    <Border Grid.Row="1"
                            IsVisible="{Binding IsCommandBarVisible}"
                            Padding="6,4"
                            Margin="0,4,0,0"
                            CornerRadius="4"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleButton Classes="fav"
                                              IsChecked="{Binding IsFavorite}"
                                              VerticalAlignment="Center"
                                              Padding="4"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              ToolTip.Tip="Mark this session as a favorite">
                                    <Path Data="{StaticResource StarGeometry}"
                                          Stretch="Uniform"
                                          Width="14" Height="14"
                                          StrokeThickness="1.3"/>
                                </ToggleButton>
                                <TextBlock Text="Model:"
                                           VerticalAlignment="Center"
                                           FontSize="12" Opacity="0.7"/>
                                <ComboBox Classes="cmxCompact"
                                          ItemsSource="{Binding AvailableModels}"
                                          SelectedIndex="{Binding SelectedModelIndex}"
                                          IsEnabled="{Binding !IsStreamingProcessAlive}"
                                          VerticalAlignment="Center"
                                          HorizontalContentAlignment="Right"
                                          FontSize="12"
                                          Padding="6,3">
                                    <!-- Closed box only: left-truncate long model IDs so the distinctive
                                         suffix (e.g. "…pus-4-8") stays visible. Deliberately NOT ItemTemplate —
                                         that would also truncate the full-width dropdown list below. -->
                                    <ComboBox.SelectionBoxItemTemplate>
                                        <DataTemplate x:CompileBindings="False">
                                            <TextBlock Text="{Binding Converter={x:Static converters:LeftEllipsisConverter.Instance}, ConverterParameter=8}"
                                                       TextAlignment="Right"/>
                                        </DataTemplate>
                                    </ComboBox.SelectionBoxItemTemplate>
                                </ComboBox>
                                <ToggleButton x:Name="ProfileActionsToggle"
                                              Classes="linklike"
                                              Content="Profile: &#x25BE;"
                                              VerticalAlignment="Center"
                                              Margin="12,0,0,0"
                                              ToolTip.Tip="Profile actions (re-authenticate, rename, delete)"/>
                                <Popup PlacementTarget="{Binding #ProfileActionsToggle}"
                                       Placement="Bottom"
                                       IsOpen="{Binding #ProfileActionsToggle.IsChecked, Mode=OneWay}"
                                       IsLightDismissEnabled="False">
                                    <Border Padding="4"
                                            CornerRadius="4"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button Content="&#x1F511;"
                                                    Command="{Binding ReauthenticateCommand}"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Padding="4,2"
                                                    ToolTip.Tip="Re-authenticate the selected profile"/>
                                            <Button Content="&#x2715;"
                                                    IsVisible="{Binding CanRemoveProfile}"
                                                    Click="OnRemoveProfileClicked"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Padding="4,2"
                                                    ToolTip.Tip="Remove the selected profile"/>
                                            <Button Content="&#x270F;"
                                                    IsVisible="{Binding CanManageSelectedProfile}"
                                                    Click="OnRenameSelectedProfileClicked"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Padding="4,2"
                                                    ToolTip.Tip="Rename the selected profile"/>
                                            <Button Content="&#x1F5D1;"
                                                    IsVisible="{Binding CanManageSelectedProfile}"
                                                    Click="OnDeleteSelectedProfileClicked"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Padding="4,2"
                                                    ToolTip.Tip="Delete the selected profile"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <ComboBox Classes="cmxCompact"
                                          ItemsSource="{Binding AvailableProfiles}"
                                          SelectedIndex="{Binding SelectedProfileIndex}"
                                          IsEnabled="{Binding !IsStreamingProcessAlive}"
                                          VerticalAlignment="Center"
                                          FontSize="12"
                                          Padding="6,3">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProfileListItemModel">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{Binding IsSystem, Converter={x:Static converters:BoolToSystemProfileForegroundConverter.Instance}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="Effort:"
                                           VerticalAlignment="Center"
                                           FontSize="12" Opacity="0.7"
                                           Margin="12,0,0,0"/>
                                <ComboBox Classes="cmxCompact"
                                          ItemsSource="{Binding AvailableEfforts}"
                                          SelectedIndex="{Binding SelectedEffortIndex}"
                                          IsEnabled="{Binding !IsStreamingProcessAlive}"
                                          VerticalAlignment="Center"
                                          FontSize="12"
                                          Padding="6,3"/>

                                <ToggleButton x:Name="ToolProfileToggle"
                                              Classes="linklike"
                                              Content="{Binding ToolProfileSummary}"
                                              IsVisible="{Binding IsLocalModelSelected}"
                                              IsEnabled="{Binding IsLocalToolSelectorEnabled}"
                                              ToolTip.Tip="{Binding ToolProfileToggleTooltip}"
                                              VerticalAlignment="Center"
                                              Width="120"
                                              Margin="12,0,0,0"/>
                                <Popup PlacementTarget="{Binding #ToolProfileToggle}"
                                       Placement="Bottom"
                                       IsOpen="{Binding #ToolProfileToggle.IsChecked, Mode=OneWay}"
                                       IsLightDismissEnabled="False">
                                    <Border Padding="8"
                                            CornerRadius="4"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                        <ItemsControl ItemsSource="{Binding ToolProfileItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ToolProfileItemViewModel">
                                                    <CheckBox Content="{Binding Name}"
                                                              IsChecked="{Binding IsEnabled}"
                                                              FontSize="12"
                                                              Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                                <ToggleButton IsChecked="{Binding IsChromeEnabled}"
                                              Content="&#x1F310;"
                                              FontSize="13"
                                              VerticalAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Width="26" Height="26" Padding="0"
                                              Margin="3,0,0,0"
                                              ToolTip.Tip="Browser control (--chrome): let Claude drive Chrome via the Claude-in-Chrome extension. Experimental — the spawn runs in -p mode; requires an OAuth profile and the installed extension."/>
                                <ToggleButton IsChecked="{Binding IsStreamingMode}"
                                              Content="&#x1F4E1;"
                                              FontSize="13"
                                              VerticalAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Width="26" Height="26" Padding="0"
                                              Margin="3,0,0,0"
                                              ToolTip.Tip="Streaming Session Mode (FR.19): keep one claude process alive across turns instead of spawning a fresh one each time, so native background tasks and scheduling survive between turns. Stop terminates the process; turning this off while it's running asks for confirmation first."/>
                                <ToggleButton IsChecked="{Binding PlayCompletionSound}"
                                              Content="&#x1F514;"
                                              FontSize="13"
                                              VerticalAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Width="26" Height="26" Padding="0"
                                              Margin="3,0,0,0"
                                              ToolTip.Tip="Session Completion Sound (FR.22): play a sound when this session finishes thinking and responds. Per-session, throttled (default 3 min between sounds); configure the sound and throttle in Settings → Notifications."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
                <!-- Right column: Send/Stop/Schedule/Gear buttons (unchanged size) -->
                <Grid Grid.Column="1" RowDefinitions="*,Auto,Auto,*" Margin="8,0,0,0">
                    <Button Grid.Row="0"
                            x:Name="SendButton"
                            Content="Send"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Command="{Binding SendCommand}"
                            PointerPressed="OnSendButtonPointerPressed"
                            ToolTip.Tip="Send (Ctrl+Enter). Right-click to schedule a delayed send."/>
                    <Button Grid.Row="1"
                            Content="&#x25A0;"
                            FontSize="12"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            IsVisible="{Binding CanStop}"
                            Command="{Binding StopCommand}"
                            ToolTip.Tip="Stop: interrupt Claude"/>
                    <Button Grid.Row="2"
                            Content="&#x23F0;"
                            FontSize="14"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            IsVisible="{Binding HasActiveSchedule}"
                            Command="{Binding CancelScheduleCommand}"
                            ToolTip.Tip="{Binding ScheduleTooltip}"/>
                    <ToggleButton Grid.Row="3"
                                  Content="&#x2699;"
                                  FontSize="16"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  VerticalAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  IsChecked="{Binding IsCommandBarVisible}"
                                  ToolTip.Tip="Toggle command bar"/>
                </Grid>
            </Grid>
        </Border>

    </Grid>

</UserControl>