<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TessynDesktop.ViewModels"
             xmlns:views="using:TessynDesktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="TessynDesktop.Views.FocusView"
             x:DataType="vm:FocusViewModel">

    <!-- Focus view (FR.23.14): Send answers, open cards, Decisions, Closed, empty state. Opaque so it covers the output area beneath it. -->
    <ScrollViewer Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,8,12,12" Spacing="6">

            <Button Content="{Binding SendAnswersText}"
                    Command="{Binding SendAnswersCommand}"
                    HorizontalAlignment="Left" Padding="12,5"/>

            <TextBlock Text="{Binding EmptyStateText}"
                       IsVisible="{Binding IsEmpty}"
                       Margin="0,8" Opacity="0.6"/>

            <ItemsControl ItemsSource="{Binding OpenItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FocusItemViewModel">
                        <views:FocusItemCard/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Expander Header="{Binding DecisionsHeader}"
                      IsVisible="{Binding HasDecisions}"
                      IsExpanded="False"
                      HorizontalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding DecidedItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FocusItemViewModel">
                            <views:FocusItemCard/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <Expander Header="{Binding ClosedHeader}"
                      IsVisible="{Binding HasClosed}"
                      IsExpanded="False"
                      HorizontalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding ClosedItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FocusItemViewModel">
                            <views:FocusItemCard/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

        </StackPanel>
    </ScrollViewer>

</UserControl>
