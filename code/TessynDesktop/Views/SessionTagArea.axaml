<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TessynDesktop.ViewModels"
             x:Class="TessynDesktop.Views.SessionTagArea"
             x:DataType="vm:SessionTagsViewModel"
             Focusable="True">
    <!-- DataContext: SessionTagsViewModel. The transparent root is what a click on empty space lands on (FR.24.16). -->
    <Grid Background="Transparent">
        <ScrollViewer x:Name="Scroller"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Disabled"
                      Focusable="False">
            <ItemsControl x:Name="Chips" ItemsSource="{Binding Chips}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionTagChipViewModel">
                        <Border Classes="tagChip"
                                ToolTip.Tip="{Binding Tooltip}"
                                PointerPressed="OnTagChipPressed">
                            <TextBlock Text="{Binding Label}" FontSize="11"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <!-- Mini mode: how many chips the single line hides; a click on it expands like any other empty space. -->
        <Border x:Name="HiddenHint"
                IsVisible="False"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,0,0,4" Padding="8,1" CornerRadius="9"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <TextBlock x:Name="HiddenHintText" FontSize="11" Opacity="0.7"/>
        </Border>
    </Grid>
</UserControl>
