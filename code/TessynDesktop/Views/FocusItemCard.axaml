<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TessynDesktop.ViewModels"
             xmlns:views="using:TessynDesktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="TessynDesktop.Views.FocusItemCard"
             x:DataType="vm:FocusItemViewModel">

    <!-- One Focus card (FR.23.14). Closed cards (IsClosed) show the outcome instead of options, reply box and close button. -->
    <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
        <StackPanel Spacing="6">

            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Background="Transparent"
                  PointerPressed="OnHeaderPressed">
                <views:AttentionKindPill Grid.Column="0" IsChip="True"
                                         Kind="{Binding Kind}" Text="{Binding KindLabel}"
                                         VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Id}"
                           Margin="8,0,0,0" FontSize="12" Opacity="0.6"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Title}"
                           Margin="8,0,8,0" FontWeight="SemiBold" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding PostedText}"
                           FontSize="10" Opacity="0.5"
                           VerticalAlignment="Center"/>
            </Grid>

            <views:MarkdownView Markdown="{Binding Body}" IsVisible="{Binding IsBodyVisible}" FontSize="13"/>

            <TextBlock Text="{Binding OutcomeText}" IsVisible="{Binding IsClosed}"
                       FontSize="12" FontStyle="Italic" Opacity="0.75" TextWrapping="Wrap"/>

            <StackPanel Spacing="6" IsVisible="{Binding IsOpen}">
                <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding HasOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Content="{Binding}" Click="OnOptionClick"
                                    Padding="8,3" FontSize="12" Margin="0,0,6,4"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="{Binding RecommendationButtonText}"
                        Command="{Binding UseRecommendationCommand}"
                        IsVisible="{Binding HasRecommendation}"
                        HorizontalAlignment="Left" Padding="8,3" FontSize="12"/>

                <views:NativeTextBox Text="{Binding ReplyText}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     Watermark="Reply..."
                                     MinHeight="56" MaxHeight="200"
                                     FontSize="13"/>

                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left"
                            Content="{Binding ReplyButtonLabel}"
                            Command="{Binding ReplyCommand}"
                            Padding="12,3" FontSize="12"/>
                    <Button DockPanel.Dock="Right"
                            Content="{Binding CloseLabel}"
                            Command="{Binding CloseCommand}"
                            ToolTip.Tip="{Binding CloseTooltip}"
                            Padding="10,3" FontSize="12"/>
                </DockPanel>
            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>
