<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TessynDesktop.ViewModels"
        xmlns:conv="using:TessynDesktop.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="TessynDesktop.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="560" Height="700"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:HexToColorConverter x:Key="HexToColor"/>
    </Window.Resources>

    <DockPanel Margin="8">
        <!-- Save button at bottom -->
        <Button DockPanel.Dock="Bottom" Content="Save"
                HorizontalAlignment="Right" Margin="8"
                Command="{Binding SaveCommand}"
                Click="OnSaveClicked"/>

        <TabControl>
            <TabControl.Resources>
                <x:Double x:Key="TabItemHeaderFontSize">14</x:Double>
                <Thickness x:Key="TabItemHeaderMargin">8,2,8,2</Thickness>
            </TabControl.Resources>

            <!-- General tab -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Session Files Directory" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding SessionFilesRoot}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="Browse..." Margin="4,0,0,0"
                                        Click="OnBrowseSessionRootClicked"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Claude CLI Path" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding ClaudePath}" Watermark="claude (resolved from PATH)"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Source Codes Location" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SourceCodesLocation}"
                                     Watermark="Auto-detected from running directory"/>
                        </StackPanel>

                        <Separator Margin="0,4"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="HTTPS Proxy" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding HttpsProxy}"
                                     Watermark="e.g. http://127.0.0.1:8080 (for Fiddler, mitmproxy, HTTP Toolkit)"/>
                            <TextBlock Text="When set, routes Claude CLI traffic through this proxy and disables TLS verification on the spawned process."
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Separator Margin="0,4"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Notifications" FontWeight="SemiBold"/>
                            <CheckBox Content="Show a desktop notification when a session asks for you"
                                      IsChecked="{Binding NotificationsEnabled}"/>
                            <TextBlock Text="A Windows toast shows the same messages that ping Telegram when a session calls notify_user. Turn completion is never announced."
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>

                            <TextBlock Text="Session completion sound" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableCompletionSounds}"
                                          SelectedItem="{Binding SessionCompletionSoundFile}"/>
                                <Button Grid.Column="1" Content="Test" Margin="4,0,0,0"
                                        Command="{Binding TestCompletionSoundCommand}"/>
                            </Grid>
                            <Grid ColumnDefinitions="120,Auto">
                                <TextBox Grid.Column="0" Text="{Binding SessionCompletionSoundThrottleSeconds}"
                                         Watermark="180"/>
                                <TextBlock Grid.Column="1" Text="seconds between sounds (per session)" VerticalAlignment="Center"
                                           Margin="8,0,0,0" Opacity="0.6"/>
                            </Grid>
                            <TextBlock Text="Plays in the command bar's 🔔 toggle (per session, default on) when a turn finishes thinking naturally — not when stopped."
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Separator Margin="0,4"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Telegram Bridge" FontWeight="SemiBold"/>
                            <CheckBox Content="Enable Telegram Bridge"
                                      IsChecked="{Binding TelegramEnabled}"/>
                            <TextBlock Text="Sessions can notify you and you can reply, browse, and message sessions from a Telegram bot. See docs/requirements.md FR.21 for one-time bot/supergroup setup."
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>

                            <TextBlock Text="Bot Token" Margin="0,8,0,0"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding TelegramBotTokenInput}"
                                         PasswordChar="•" Watermark="Paste token from @BotFather"/>
                                <Button Grid.Column="1" Content="Save Token" Margin="4,0,0,0"
                                        Command="{Binding SaveTelegramTokenCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding TelegramTokenStatus}" FontSize="11" Opacity="0.6"/>

                            <TextBlock Text="Supergroup Chat ID" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding TelegramChatId}" Watermark="e.g. -1001234567890"/>

                            <TextBlock Text="Allowed Telegram User IDs" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding TelegramAllowedUserIds}" Watermark="Comma-separated, e.g. 123456789, 987654321"/>

                            <TextBlock Text="Mention Handle" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding TelegramMentionHandle}" Watermark="e.g. @harmlessevil"/>
                            <TextBlock Text="Prefixed onto notify_user pings so they stand out from the mirrored conversation text sharing the same topic. Leave blank for no prefix."
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>

                            <TextBlock Text="Mirror" Margin="0,8,0,0"/>
                            <ComboBox ItemsSource="{Binding TelegramMirrorModeOptions}"
                                      SelectedIndex="{Binding TelegramMirrorModeIndex}"/>
                            <TextBlock Text="What is posted to a session's topic: Full (every message), Answers only (each turn's final answer, plus any error), or Off. Only notify_user pings make a sound."
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Separator Margin="0,4"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Web access" FontWeight="SemiBold"/>
                            <CheckBox Content="Enable web access"
                                      IsChecked="{Binding RelayEnabled}"/>
                            <TextBlock Text="Lets the Tessyn web client reach this desktop. The desktop connects out to the web server; nothing listens for incoming connections. Saved immediately, no restart needed."
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>

                            <TextBlock Text="Web server URL" Margin="0,8,0,0"/>
                            <TextBox Text="{Binding RelayUrl}" Watermark="https://tessyn.vvinogradoff.com"/>

                            <TextBlock Text="Link token" Margin="0,8,0,0"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding RelayTokenInput}"
                                         PasswordChar="•" Watermark="Paste the link token (leave empty to keep the current one)"/>
                                <Button Grid.Column="1" Content="Save" Margin="4,0,0,0"
                                        Command="{Binding SaveRelayCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding RelayTokenStatus}" FontSize="11" Opacity="0.6"/>
                            <TextBlock Text="{Binding RelayStatusText}" FontSize="11" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Appearance tab -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Theme" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <RadioButton Content="Dark" IsChecked="{Binding IsDarkTheme}" GroupName="Theme"/>
                                <RadioButton Content="Light" IsChecked="{Binding !IsDarkTheme}" GroupName="Theme"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Tag cloud font size" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding TagFontSize}" Width="90" HorizontalAlignment="Left" AutomationProperties.Name="Tag cloud font size"/>
                            <TextBlock Text="Size in points (8 to 40) of the tag chips and the +N hint under the session header. Applied when you save."
                                       FontSize="11" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Separator Margin="0,4"/>

                        <TextBlock Text="Colors (for selected theme)" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,8,8">
                                <TextBlock Text="Input box background" FontSize="12" Opacity="0.7"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding InputBoxBackground}" FontFamily="Consolas" FontSize="12"/>
                                    <ColorPicker Grid.Column="1" Margin="4,0,0,0" Width="32" Height="32"
                                                 Color="{Binding InputBoxBackground, Converter={StaticResource HexToColor}}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="0,0,0,8">
                                <TextBlock Text="Input box text" FontSize="12" Opacity="0.7"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding InputBoxText}" FontFamily="Consolas" FontSize="12"/>
                                    <ColorPicker Grid.Column="1" Margin="4,0,0,0" Width="32" Height="32"
                                                 Color="{Binding InputBoxText, Converter={StaticResource HexToColor}}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,0,8,8">
                                <TextBlock Text="User bubble background" FontSize="12" Opacity="0.7"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding UserBubbleBackground}" FontFamily="Consolas" FontSize="12"/>
                                    <ColorPicker Grid.Column="1" Margin="4,0,0,0" Width="32" Height="32"
                                                 Color="{Binding UserBubbleBackground, Converter={StaticResource HexToColor}}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="0,0,0,8">
                                <TextBlock Text="User bubble text" FontSize="12" Opacity="0.7"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding UserBubbleText}" FontFamily="Consolas" FontSize="12"/>
                                    <ColorPicker Grid.Column="1" Margin="4,0,0,0" Width="32" Height="32"
                                                 Color="{Binding UserBubbleText, Converter={StaticResource HexToColor}}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2" Margin="0,0,8,8">
                                <TextBlock Text="Code block background" FontSize="12" Opacity="0.7"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding CodeBlockBackground}" FontFamily="Consolas" FontSize="12"/>
                                    <ColorPicker Grid.Column="1" Margin="4,0,0,0" Width="32" Height="32"
                                                 Color="{Binding CodeBlockBackground, Converter={StaticResource HexToColor}}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2" Margin="0,0,0,8">
                                <TextBlock Text="Code block text" FontSize="12" Opacity="0.7"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding CodeBlockText}" FontFamily="Consolas" FontSize="12"/>
                                    <ColorPicker Grid.Column="1" Margin="4,0,0,0" Width="32" Height="32"
                                                 Color="{Binding CodeBlockText, Converter={StaticResource HexToColor}}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="0" Spacing="2" Margin="0,0,8,8">
                                <TextBlock Text="Inline code background" FontSize="12" Opacity="0.7"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding InlineCodeBackground}" FontFamily="Consolas" FontSize="12"/>
                                    <ColorPicker Grid.Column="1" Margin="4,0,0,0" Width="32" Height="32"
                                                 Color="{Binding InlineCodeBackground, Converter={StaticResource HexToColor}}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2" Margin="0,0,0,8">
                                <TextBlock Text="Inline code text" FontSize="12" Opacity="0.7"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding InlineCodeText}" FontFamily="Consolas" FontSize="12"/>
                                    <ColorPicker Grid.Column="1" Margin="4,0,0,0" Width="32" Height="32"
                                                 Color="{Binding InlineCodeText, Converter={StaticResource HexToColor}}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="0" Spacing="2" Margin="0,0,8,8">
                                <TextBlock Text="System bubble background" FontSize="12" Opacity="0.7"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding SystemBubbleBackground}" FontFamily="Consolas" FontSize="12"/>
                                    <ColorPicker Grid.Column="1" Margin="4,0,0,0" Width="32" Height="32"
                                                 Color="{Binding SystemBubbleBackground, Converter={StaticResource HexToColor}}"/>
                                </Grid>
                            </StackPanel>
                            <TextBlock Grid.Row="5" Grid.ColumnSpan="2"
                                       Text="Session recency bars" FontSize="12" FontWeight="SemiBold"
                                       Opacity="0.7" Margin="0,4,0,4"/>
                            <StackPanel Grid.Row="6" Grid.Column="0" Spacing="2" Margin="0,0,8,8">
                                <TextBlock Text="Active (15 min)" FontSize="12" Opacity="0.7"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding Recency15MinBackground}" FontFamily="Consolas" FontSize="12"/>
                                    <ColorPicker Grid.Column="1" Margin="4,0,0,0" Width="32" Height="32"
                                                 Color="{Binding Recency15MinBackground, Converter={StaticResource HexToColor}}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Row="6" Grid.Column="1" Spacing="2" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                        <TextBlock Text="Recent (30 min)" FontSize="12" Opacity="0.7"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Text="{Binding Recency30MinBackground}" FontFamily="Consolas" FontSize="12"/>
                                            <ColorPicker Grid.Column="1" Margin="4,0,0,0" Width="32" Height="32"
                                                         Color="{Binding Recency30MinBackground, Converter={StaticResource HexToColor}}"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Past hour (60 min)" FontSize="12" Opacity="0.7"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Text="{Binding Recency60MinBackground}" FontFamily="Consolas" FontSize="12"/>
                                            <ColorPicker Grid.Column="1" Margin="4,0,0,0" Width="32" Height="32"
                                                         Color="{Binding Recency60MinBackground, Converter={StaticResource HexToColor}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Screensaver tab -->
            <TabItem Header="Screensaver">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Inactivity Timeout" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="120,Auto">
                                <TextBox Grid.Column="0" Text="{Binding ScreensaverTimeout}"
                                         Watermark="seconds"/>
                                <TextBlock Grid.Column="1" Text="seconds" VerticalAlignment="Center"
                                           Margin="8,0,0,0" Opacity="0.6"/>
                            </Grid>
                            <TextBlock Text="Set to 0 to disable the screensaver."
                                       FontSize="11" Opacity="0.5"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Images Directory" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding ScreensaverDirectory}"
                                         IsReadOnly="True" Watermark="No images — black screen"/>
                                <Button Grid.Column="1" Content="Browse..." Margin="4,0,0,0"
                                        Click="OnBrowseScreensaverDirectoryClicked"/>
                            </Grid>
                            <TextBlock Text="Supported formats: PNG, JPG, JPEG, BMP, GIF, WEBP."
                                       FontSize="11" Opacity="0.5"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Slideshow Interval" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="120,Auto">
                                <TextBox Grid.Column="0" Text="{Binding ScreensaverSlideshowInterval}"
                                         Watermark="10"/>
                                <TextBlock Grid.Column="1" Text="seconds" VerticalAlignment="Center"
                                           Margin="8,0,0,0" Opacity="0.6"/>
                            </Grid>
                            <TextBlock Text="Time between image transitions. Minimum 1 second."
                                       FontSize="11" Opacity="0.5"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Keyboard Shortcuts tab -->
            <TabItem Header="Keyboard Shortcuts">
                <StackPanel Margin="12" Spacing="8">
                    <TextBlock Text="Edit key bindings for actions. Use Cmd/Ctrl + key format. Separate multiple bindings with comma."
                               Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding KeyBindingEntries}" x:CompileBindings="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,*" Margin="0,4">
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                               VerticalAlignment="Center" FontSize="13"/>
                                    <TextBox Grid.Column="1" Text="{Binding Binding}"
                                             FontFamily="Consolas" FontSize="12"
                                             Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>

            <!-- MCP Servers tab (FR.20.7) -->
            <TabItem Header="MCP Servers">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Servers registered here are merged into every session's --mcp-config alongside the built-in cmx tools. Independent of any claude.ai connector registrations."
                               Opacity="0.6" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Add..." Click="OnAddMcpServerClicked"/>
                        <Button Content="Edit..." Click="OnEditMcpServerClicked"
                                IsEnabled="{Binding SelectedMcpServer, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Content="Remove" Click="OnRemoveMcpServerClicked"
                                IsEnabled="{Binding SelectedMcpServer, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Content="Authorize..." Click="OnAuthorizeMcpServerClicked"
                                IsVisible="{Binding SelectedMcpServer.ShowAuthorizeButton}"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding McpServers}" SelectedItem="{Binding SelectedMcpServer}"
                             x:CompileBindings="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Top" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding TransportSummary}" FontSize="11" Opacity="0.6"/>
                                        <TextBlock Text="{Binding AuthSummary}" FontSize="11" Opacity="0.6"/>
                                        <TextBlock Text="{Binding LastActionMessage}" FontSize="11" Foreground="OrangeRed"
                                                   IsVisible="{Binding LastActionMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12"
                                               VerticalAlignment="Top" HorizontalAlignment="Right" Opacity="0.8"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>

</Window>
