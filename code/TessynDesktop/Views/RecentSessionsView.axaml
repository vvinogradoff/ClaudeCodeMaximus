<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TessynDesktop.ViewModels"
             xmlns:views="using:TessynDesktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="TessynDesktop.Views.RecentSessionsView"
             x:DataType="vm:RecentSessionsViewModel">

    <!-- FR.1.16 — the Recent tab is the shared collapsible session-group list -->
    <views:SessionGroupListView DataContext="{Binding}"/>

</UserControl>
