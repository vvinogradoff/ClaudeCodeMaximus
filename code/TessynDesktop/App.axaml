<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TessynDesktop.App"
             xmlns:local="using:TessynDesktop"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

   <Application.DataTemplates>
       <local:ViewLocator/>
   </Application.DataTemplates>

   <Application.Resources>
   <ResourceDictionary>
       <!-- Shared 5-point star outline, used by the favorite toggle (command bar) and the
            display-only favorite indicators (session tree, Recent tab, recent-sessions dropdown). -->
       <StreamGeometry x:Key="StarGeometry">M12,2 L14.7,8.8 L22,9.3 L16.4,14.1 L18.2,21.2 L12,17.3 L5.8,21.2 L7.6,14.1 L2,9.3 L9.3,8.8 Z</StreamGeometry>

       <!-- Automated inputs (FR.2.6): teal, readable on both themes, whatever colours were chosen for the user bubble. -->
       <ResourceDictionary.ThemeDictionaries>
           <ResourceDictionary x:Key="Dark">
               <SolidColorBrush x:Key="CmxAutoBubbleBg" Color="#0F5C56"/>
               <SolidColorBrush x:Key="CmxAutoBubbleFg" Color="#FFFFFF"/>
               <SolidColorBrush x:Key="CmxAutoLabelFg" Color="#80CBC4"/>
               <SolidColorBrush x:Key="CmxInputSelectionBrush" Color="#E0E0E0"/>
           </ResourceDictionary>
           <ResourceDictionary x:Key="Light">
               <SolidColorBrush x:Key="CmxAutoBubbleBg" Color="#CDEEEA"/>
               <SolidColorBrush x:Key="CmxAutoBubbleFg" Color="#10302D"/>
               <SolidColorBrush x:Key="CmxAutoLabelFg" Color="#00695C"/>
               <SolidColorBrush x:Key="CmxInputSelectionBrush" Color="#303030"/>
           </ResourceDictionary>
       </ResourceDictionary.ThemeDictionaries>
   </ResourceDictionary>
   </Application.Resources>

   <Application.Styles>
       <FluentTheme />

       <!-- Input bubbles (FR.2.6): the colours chosen for the user bubble, or teal for an automated input -->
       <Style Selector="Border.inputBubble">
           <Setter Property="Background" Value="{DynamicResource CmxUserBubbleBg}"/>
       </Style>
       <Style Selector="Border.inputBubble :is(TextBlock)">
           <Setter Property="Foreground" Value="{DynamicResource CmxUserBubbleFg}"/>
       </Style>
       <Style Selector="Border.inputBubble.automated">
           <Setter Property="Background" Value="{DynamicResource CmxAutoBubbleBg}"/>
       </Style>
       <Style Selector="Border.inputBubble.automated :is(TextBlock)">
           <Setter Property="Foreground" Value="{DynamicResource CmxAutoBubbleFg}"/>
       </Style>
       <!-- The label's opacity is a style, not a local value, so the automated label can override it (full opacity keeps it readable on teal) -->
       <Style Selector="Border.inputBubble TextBlock.userLabel">
           <Setter Property="Opacity" Value="0.6"/>
       </Style>
       <Style Selector="Border.inputBubble.automated TextBlock.automatedLabel">
           <Setter Property="Foreground" Value="{DynamicResource CmxAutoLabelFg}"/>
           <Setter Property="FontWeight" Value="SemiBold"/>
           <Setter Property="Opacity" Value="1"/>
       </Style>

       <!-- Tag chips (FR.24.7), shared by the session Tag row and the Tags tab (FR.24.11) -->
       <Style Selector="Border.tagChip">
           <Setter Property="CornerRadius" Value="9"/>
           <Setter Property="BorderThickness" Value="1"/>
           <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
           <Setter Property="Padding" Value="8,1"/>
           <Setter Property="Margin" Value="0,0,6,4"/>
           <Setter Property="Cursor" Value="Hand"/>
           <Setter Property="Background" Value="Transparent"/>
       </Style>
       <Style Selector="Border.tagChip:pointerover">
           <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
       </Style>
       <!-- Selected chip (FR.24.12): accent fill with the theme's on-accent text colour; stays visible on hover -->
       <Style Selector="Border.tagChip.selected">
           <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
           <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}"/>
       </Style>
       <Style Selector="Border.tagChip.selected:pointerover">
           <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}"/>
       </Style>
       <Style Selector="Border.tagChip.selected TextBlock">
           <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}"/>
       </Style>
   </Application.Styles>

</Application>
