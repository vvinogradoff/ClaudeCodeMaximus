<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TessynDesktop.App"
             xmlns:local="using:TessynDesktop"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

   <Application.DataTemplates>
       <local:ViewLocator/>
   </Application.DataTemplates>

   <Application.Resources>
       <!-- Shared 5-point star outline, used by the favorite toggle (command bar) and the
            display-only favorite indicators (session tree, Recent tab, recent-sessions dropdown). -->
       <StreamGeometry x:Key="StarGeometry">M12,2 L14.7,8.8 L22,9.3 L16.4,14.1 L18.2,21.2 L12,17.3 L5.8,21.2 L7.6,14.1 L2,9.3 L9.3,8.8 Z</StreamGeometry>
   </Application.Resources>

   <Application.Styles>
       <FluentTheme />

       <!-- Tag chips (FR.24.7), shared by the session Tag row and the Tags tab (FR.24.11) -->
       <Style Selector="Border.tagChip">
           <Setter Property="CornerRadius" Value="9"/>
           <Setter Property="BorderThickness" Value="1"/>
           <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
           <Setter Property="Padding" Value="8,1"/>
           <Setter Property="Margin" Value="0,0,6,4"/>
           <Setter Property="Cursor" Value="Hand"/>
           <Setter Property="Background" Value="Transparent"/>
       </Style>
       <Style Selector="Border.tagChip:pointerover">
           <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
       </Style>
       <!-- Selected chip (FR.24.12): accent fill with the theme's on-accent text colour; stays visible on hover -->
       <Style Selector="Border.tagChip.selected">
           <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
           <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}"/>
       </Style>
       <Style Selector="Border.tagChip.selected:pointerover">
           <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}"/>
       </Style>
       <Style Selector="Border.tagChip.selected TextBlock">
           <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}"/>
       </Style>
   </Application.Styles>

</Application>
