<UserControl x:Class="TessynDesktop.WPF.Views.Settings.StartupSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:TessynDesktop.WPF.Views.Settings">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,4,16,16" MaxWidth="560" HorizontalAlignment="Left">
            <CheckBox Margin="0,12,0,0" Content="Start the background daemon when none is running" IsChecked="{Binding StartBackgroundDaemon}" AutomationProperties.Name="Start the background daemon" />
            <TextBlock Style="{StaticResource SettingsHint}" Text="{Binding Hint}" />
            <CheckBox Margin="0,16,0,0" Content="Start daemon elevated" IsChecked="{Binding StartDaemonElevated}" AutomationProperties.Name="Start daemon elevated" />
            <TextBlock Style="{StaticResource SettingsHint}" Text="{Binding ElevatedHint}" />
            <StackPanel Margin="0,16,0,0" Visibility="{Binding HasDaemonControl, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding DaemonStatusText}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="Daemon elevation" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource SettingsButton}" Content="Restart daemon elevated" Command="{Binding RestartDaemonElevatedCommand}" AutomationProperties.Name="Restart daemon elevated" />
                    <Button Style="{StaticResource SettingsButton}" Content="Restart daemon normal" Command="{Binding RestartDaemonNormalCommand}" AutomationProperties.Name="Restart daemon normal" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource SettingsHint}" Text="{Binding RestartHint}" />
                <TextBlock Style="{StaticResource SettingsHint}" Text="{Binding RestartNote}" AutomationProperties.Name="Daemon restart note" />
            </StackPanel>
            <s:SectionMessages Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
