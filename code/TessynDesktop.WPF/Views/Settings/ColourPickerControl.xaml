<UserControl x:Class="TessynDesktop.WPF.Views.Settings.ColourPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:st="clr-namespace:TessynDesktop.WPF.State"
             Width="300" Focusable="True" KeyDown="OnKeyDown">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="HarmonyPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="HarmonySwatch">
            <Button Margin="0,2,6,2" Width="44" Height="20" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{Binding}"
                    ToolTip="{Binding}" AutomationProperties.Name="{Binding StringFormat=Harmony {0}}"
                    Command="{Binding DataContext.PickHarmonyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <!-- The colour picker (DataContext: ColourPickerViewModel): previews of the old and the new colour, a saturation/value square over the hue, a hue and an opacity slider, a palette,
         the three harmonies and the named colours. No hex text box. Dragging only changes the new colour (FR.9.19). It may grow, so it scrolls when the screen is short. -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="10">
        <Grid Height="26" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="22" CornerRadius="3,0,0,3" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{Binding OldHex}"
                    ToolTip="Old colour" AutomationProperties.Name="Old colour" />
            <Border Grid.Column="1" Width="48" Height="22" CornerRadius="0,3,3,0" BorderThickness="0,1,1,1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{Binding Hex}"
                    ToolTip="New colour" AutomationProperties.Name="New colour" />
            <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding ColourName}" ToolTip="{Binding ColourName}"
                       AutomationProperties.Name="Colour name" />
        </Grid>
        <Grid x:Name="Square" Height="160" Background="{Binding HueHex}" Cursor="Cross" SnapsToDevicePixels="True" ClipToBounds="True"
              AutomationProperties.Name="Saturation and brightness" SizeChanged="OnSquareSizeChanged"
              MouseLeftButtonDown="OnSquareDown" MouseMove="OnSquareMove" MouseLeftButtonUp="OnSquareUp">
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="Thumb" Width="14" Height="14" Stroke="White" StrokeThickness="2" Canvas.Left="-7" Canvas.Top="-7">
                    <Ellipse.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.8" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>
        <Grid Margin="0,10,0,0" Height="20">
            <Border CornerRadius="3" Margin="0,4">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF0000" Offset="0" />
                        <GradientStop Color="#FFFF00" Offset="0.1667" />
                        <GradientStop Color="#00FF00" Offset="0.3333" />
                        <GradientStop Color="#00FFFF" Offset="0.5" />
                        <GradientStop Color="#0000FF" Offset="0.6667" />
                        <GradientStop Color="#FF00FF" Offset="0.8333" />
                        <GradientStop Color="#FF0000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Slider Minimum="0" Maximum="360" Value="{Binding Hue, Mode=TwoWay}" Background="Transparent" AutomationProperties.Name="Hue" />
        </Grid>
        <Grid Margin="0,6,0,0" Height="20">
            <Border CornerRadius="3" Margin="0,4" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00808080" Offset="0" />
                        <GradientStop Color="#FF808080" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Slider Minimum="0" Maximum="255" Value="{Binding Alpha, Mode=TwoWay}" Background="Transparent" AutomationProperties.Name="Opacity" />
        </Grid>
        <ItemsControl Margin="0,10,0,0" ItemsSource="{x:Static vm:ColourPickerViewModel.Palette}" AutomationProperties.Name="Palette"
                      xmlns:vm="clr-namespace:TessynDesktop.WPF.ViewModels.Settings">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="12" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="1" Height="16" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{Binding}"
                            ToolTip="{Binding}" AutomationProperties.Name="{Binding StringFormat=Palette {0}}"
                            Command="{Binding DataContext.PickPaletteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Harmonies of the new colour: complementary (hue + 180), analogous (hue - 30 and + 30), triadic (hue + 120 and + 240) -->
        <Grid Margin="0,10,0,0" x:Name="Harmonies">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Complementary" Margin="0,0,10,0" VerticalAlignment="Center" MinWidth="88" />
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Complementary}" ItemTemplate="{StaticResource HarmonySwatch}" ItemsPanel="{StaticResource HarmonyPanel}" AutomationProperties.Name="Complementary" />
            <TextBlock Grid.Row="1" Text="Analogous" Margin="0,0,10,0" VerticalAlignment="Center" />
            <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Analogous}" ItemTemplate="{StaticResource HarmonySwatch}" ItemsPanel="{StaticResource HarmonyPanel}" AutomationProperties.Name="Analogous" />
            <TextBlock Grid.Row="2" Text="Triadic" Margin="0,0,10,0" VerticalAlignment="Center" />
            <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Triadic}" ItemTemplate="{StaticResource HarmonySwatch}" ItemsPanel="{StaticResource HarmonyPanel}" AutomationProperties.Name="Triadic" />
        </Grid>
        <!-- Named colours: the 140 CSS names, filtered by part of a name -->
        <TextBlock Text="Named colours" FontWeight="SemiBold" Margin="0,12,0,4" />
        <TextBox x:Name="NamedFilterBox" Text="{Binding NamedFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter named colours" ToolTip="Type part of a colour name" />
        <ListBox x:Name="NamedList" Margin="0,4,0,0" Height="120" ItemsSource="{Binding NamedColours}" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.Name="Named colours">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type st:NamedColour}">
                    <Button Margin="1" Padding="4,1" HorizontalContentAlignment="Left" BorderThickness="0" Background="Transparent" ToolTip="{Binding Hex}"
                            AutomationProperties.Name="{Binding Name, StringFormat=Named {0}}"
                            Command="{Binding DataContext.PickNamedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Hex}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="14" Height="14" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{Binding Hex}" />
                            <TextBlock Margin="6,0,0,0" Text="{Binding Name}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
    </ScrollViewer>
</UserControl>
