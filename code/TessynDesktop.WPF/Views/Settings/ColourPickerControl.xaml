<UserControl x:Class="TessynDesktop.WPF.Views.Settings.ColourPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="252">
    <!-- The colour picker (DataContext: ColourPickerViewModel): a saturation/value square over the hue, a hue and an opacity slider, and a palette. No hex text box. -->
    <StackPanel Margin="10">
        <Grid x:Name="Square" Height="160" Background="{Binding HueHex}" Cursor="Cross" SnapsToDevicePixels="True" ClipToBounds="True"
              AutomationProperties.Name="Saturation and brightness" SizeChanged="OnSquareSizeChanged"
              MouseLeftButtonDown="OnSquareDown" MouseMove="OnSquareMove" MouseLeftButtonUp="OnSquareUp">
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="Thumb" Width="14" Height="14" Stroke="White" StrokeThickness="2" Canvas.Left="-7" Canvas.Top="-7">
                    <Ellipse.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.8" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>
        <Grid Margin="0,10,0,0" Height="20">
            <Border CornerRadius="3" Margin="0,4">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF0000" Offset="0" />
                        <GradientStop Color="#FFFF00" Offset="0.1667" />
                        <GradientStop Color="#00FF00" Offset="0.3333" />
                        <GradientStop Color="#00FFFF" Offset="0.5" />
                        <GradientStop Color="#0000FF" Offset="0.6667" />
                        <GradientStop Color="#FF00FF" Offset="0.8333" />
                        <GradientStop Color="#FF0000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Slider Minimum="0" Maximum="360" Value="{Binding Hue, Mode=TwoWay}" Background="Transparent" AutomationProperties.Name="Hue" />
        </Grid>
        <Grid Margin="0,6,0,0" Height="20">
            <Border CornerRadius="3" Margin="0,4" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00808080" Offset="0" />
                        <GradientStop Color="#FF808080" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Slider Minimum="0" Maximum="255" Value="{Binding Alpha, Mode=TwoWay}" Background="Transparent" AutomationProperties.Name="Opacity" />
        </Grid>
        <ItemsControl Margin="0,10,0,0" ItemsSource="{x:Static vm:ColourPickerViewModel.Palette}" AutomationProperties.Name="Palette"
                      xmlns:vm="clr-namespace:TessynDesktop.WPF.ViewModels.Settings">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="12" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="1" Height="16" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{Binding}"
                            ToolTip="{Binding}" AutomationProperties.Name="{Binding StringFormat=Palette {0}}"
                            Command="{Binding DataContext.PickPaletteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
