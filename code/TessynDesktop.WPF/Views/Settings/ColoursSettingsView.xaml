<UserControl x:Class="TessynDesktop.WPF.Views.Settings.ColoursSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:TessynDesktop.WPF.Views.Settings"
             xmlns:vm="clr-namespace:TessynDesktop.WPF.ViewModels.Settings">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Views/Settings/SettingsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <CollectionViewSource x:Key="Grouped" Source="{Binding Rows}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Group" />
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,4,16,4">
            <TextBlock Style="{StaticResource SettingsHint}" Text="{Binding Hint}" />
            <DockPanel Margin="0,10,0,0" x:Name="ThemeRow">
                <Button DockPanel.Dock="Right" x:Name="ApplyButton" Padding="14,4" Content="Apply" Command="{Binding ApplyCommand}" AutomationProperties.Name="Apply colours"
                        ToolTip="Store the pending colours, close the open picker and apply the colours everywhere" />
                <StackPanel Orientation="Horizontal">
                <TextBlock Text="Theme to edit" VerticalAlignment="Center" Margin="0,0,10,0" />
                <RadioButton GroupName="ColourTheme" Content="Light" IsChecked="{Binding EditingLight, Mode=TwoWay}" Margin="0,0,10,0" MinWidth="0" AutomationProperties.Name="Edit Light colours" />
                <RadioButton GroupName="ColourTheme" Content="Dark" IsChecked="{Binding EditingDark, Mode=TwoWay}" MinWidth="0" AutomationProperties.Name="Edit Dark colours" />
                <Button Margin="24,0,0,0" Padding="10,4" Content="{Binding ResetAllText}" Command="{Binding ResetAllCommand}" AutomationProperties.Name="Reset all colours" x:Name="ResetAllButton" />
                </StackPanel>
            </DockPanel>
            <s:SectionMessages />
        </StackPanel>
        <ListBox ItemsSource="{Binding Source={StaticResource Grouped}}" BorderThickness="0" Background="Transparent" Margin="12,0,12,8" Focusable="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Colours">
            <!-- The rows inside a group use the ListBox's own panel (GroupStyle.Panel would lay out the groups): two equal columns, one under ~640 px -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <s:TwoColumnPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <!-- The right margin keeps the swatches off the scrollbar -->
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Margin" Value="0,0,12,10" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <StackPanel>
                                            <ContentPresenter />
                                            <ItemsPresenter />
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,0,0,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ColourRowViewModel}">
                    <Grid Margin="4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="100" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                        <Button Grid.Column="1" Width="44" Height="22" Margin="8,0" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{Binding Hex}" Command="{Binding OpenPickerCommand}" AutomationProperties.Name="{Binding AutomationName}"
                                ToolTip="{Binding DefaultHex, StringFormat=Click to change. Default: {0}}" x:Name="Swatch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" />
                                        <!-- The dot marks a colour that is picked but not applied yet (FR.9.19) -->
                                        <Ellipse Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Fill="White" Stroke="Black" StrokeThickness="1" x:Name="PendingDot"
                                                 Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}" ToolTip="Not applied yet" />
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <!-- While the picker is open a click on the swatch only closes it (the popup closes on the outside click) -->
                                        <DataTrigger Binding="{Binding IsPickerOpen}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Popup IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=Swatch}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Margin="0,0,8,8" Background="{DynamicResource ControlSolidFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.35" />
                                </Border.Effect>
                                <s:ColourPickerControl DataContext="{Binding Picker}" />
                            </Border>
                        </Popup>
                        <Button Grid.Column="2" Margin="6,0,0,0" Padding="8,3" Content="Reset" Command="{Binding ResetCommand}" AutomationProperties.Name="{Binding ResetAutomationName}"
                                Visibility="{Binding IsOverridden, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
