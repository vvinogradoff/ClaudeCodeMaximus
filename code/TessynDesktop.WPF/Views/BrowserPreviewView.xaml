<UserControl x:Class="TessynDesktop.WPF.Views.BrowserPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <Style x:Key="BarButton" TargetType="Button">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Width" Value="34" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Bar: the address stretches, the buttons keep their places and sizes (NR.7) -->
        <DockPanel Grid.Row="0" Margin="12,8,12,8" LastChildFill="True">
            <Button DockPanel.Dock="Left" Style="{StaticResource BarButton}" Command="{Binding BackCommand}" ToolTip="Back"
                    AutomationProperties.Name="Browser back">
                <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphBack}" />
            </Button>
            <Button DockPanel.Dock="Left" Style="{StaticResource BarButton}" Command="{Binding ForwardCommand}" ToolTip="Forward"
                    AutomationProperties.Name="Browser forward">
                <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphForward}" />
            </Button>
            <Button DockPanel.Dock="Left" Command="{Binding ReloadOrStopCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                        <Setter Property="ToolTip" Value="Reload" />
                        <Setter Property="AutomationProperties.Name" Value="Reload page" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="ToolTip" Value="Stop loading" />
                                <Setter Property="AutomationProperties.Name" Value="Stop loading" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <TextBlock FontSize="12" Text="{StaticResource GlyphRefresh}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphStop}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Margin="4,0,0,0" Command="{Binding OpenInSystemBrowserCommand}"
                    ToolTip="Open in system browser" AutomationProperties.Name="Open in system browser">
                <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphOpenInNew}" />
            </Button>
            <TextBox x:Name="AddressBox" Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="8,5"
                     GotKeyboardFocus="OnAddressGotFocus" LostKeyboardFocus="OnAddressLostFocus" PreviewKeyDown="OnAddressKeyDown"
                     AutomationProperties.Name="Page address" />
        </DockPanel>

        <!-- Error line, dismissible -->
        <DockPanel Grid.Row="1" Margin="12,0,12,8" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Right" Command="{Binding DismissErrorCommand}" Margin="8,0,0,0" Padding="8,4" ToolTip="Dismiss"
                    AutomationProperties.Name="Dismiss error">
                <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphClose}" />
            </Button>
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </DockPanel>

        <!-- The page; the WebView2 control is created when the view is first loaded. -->
        <Grid Grid.Row="2" x:Name="PageHost" />
    </Grid>
</UserControl>
