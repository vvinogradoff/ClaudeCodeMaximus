<UserControl x:Class="TessynDesktop.WPF.Views.TreeToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ToolbarButton" TargetType="Button">
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- The commands act on the selected node; each button carries its automation name (UI Automation and the E2E tests find it by it). -->
    <WrapPanel Margin="8,6,8,0">
        <Button Style="{StaticResource ToolbarButton}" Content="Add directory" Command="{Binding AddDirectoryCommand}"
                AutomationProperties.Name="Add directory" ToolTip="Add a folder to the tree" />
        <Button Style="{StaticResource ToolbarButton}" Content="New session" Command="{Binding AddSessionCommand}"
                AutomationProperties.Name="New session" ToolTip="New session in the selected directory or group" />
        <Button Style="{StaticResource ToolbarButton}" Content="New group" Command="{Binding AddGroupCommand}"
                AutomationProperties.Name="New group" ToolTip="New group under the selected directory or group" />
        <Button Style="{StaticResource ToolbarButton}" Content="Rename" Command="{Binding RenameCommand}"
                AutomationProperties.Name="Rename" ToolTip="Rename the selected session or group (F2)" />
        <Button Style="{StaticResource ToolbarButton}" Content="Delete" Command="{Binding DeleteCommand}"
                AutomationProperties.Name="Delete" ToolTip="Delete the selected node (Delete)" />
        <Button Style="{StaticResource ToolbarButton}" Content="Move to…" Command="{Binding MoveToCommand}"
                AutomationProperties.Name="Move to" ToolTip="Move the selected session into another directory or group" />
        <Button Style="{StaticResource ToolbarButton}" Command="{Binding RefreshGitOriginsCommand}"
                AutomationProperties.Name="Refresh git origins" ToolTip="Read the git origins of the directories again">
            <TextBlock Style="{StaticResource IconText}" Text="{StaticResource GlyphRefresh}" FontSize="12" />
        </Button>
    </WrapPanel>
</UserControl>
