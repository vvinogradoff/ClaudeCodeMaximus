<UserControl x:Class="TessynDesktop.WPF.Views.ProfileFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="FlyoutLink" TargetType="Button">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>
    <Grid Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
        <ToggleButton x:Name="Toggle" Margin="2,0" Padding="8,2" FontSize="12" Content="Profiles" AutomationProperties.Name="Profiles" ToolTip="Profiles and sign-in"
                      IsChecked="{Binding IsOpen, Mode=TwoWay}" />
        <Popup PlacementTarget="{Binding ElementName=Toggle}" Placement="Top" StaysOpen="False" IsOpen="{Binding IsOpen, Mode=TwoWay}">
            <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                    Padding="8" MinWidth="380" MaxHeight="420">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Profiles" Margin="0,0,0,6" />
                    <!-- FR.33.13: the open session's ChatGPT profile, with Sign in again on an auth error (never Claude's re-authenticate; rename and delete live in Settings) -->
                    <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,6" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="{Binding HasSessionChatGptProfile, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Session ChatGPT profile">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SessionChatGptHeader}" />
                            <DockPanel Margin="0,2,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource FlyoutLink}" Content="Sign in again" Command="{Binding SignInSessionProfileAgainCommand}"
                                        Visibility="{Binding SessionNeedsSignIn, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="{Binding SessionSignInAgainName}" />
                                <StackPanel>
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding SessionChatGptProfile.DisplayName, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding SessionChatGptProfile.PlanText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SessionChatGptProfile.StateText}" />
                                </StackPanel>
                            </DockPanel>
                            <!-- The sign-in in progress (started here or in Settings): the code and the address when signing in with a code; Cancel ends it -->
                            <StackPanel DataContext="{Binding SignIn}" Margin="0,6,0,0" AutomationProperties.Name="Flyout ChatGPT sign-in">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Text="{Binding Instruction}" />
                                <TextBox Margin="0,4,0,0" IsReadOnly="True" Text="{Binding UserCode, Mode=OneWay}" FontFamily="Consolas" Visibility="{Binding IsDeviceCode, Converter={StaticResource BoolToVis}}"
                                         AutomationProperties.Name="Flyout sign-in code" />
                                <TextBox Margin="0,4,0,0" IsReadOnly="True" Text="{Binding Address, Mode=OneWay}" Visibility="{Binding ShowsAddress, Converter={StaticResource BoolToVis}}"
                                         AutomationProperties.Name="Flyout sign-in address" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding DeviceCodeNote}"
                                           Visibility="{Binding IsDeviceCode, Converter={StaticResource BoolToVis}}" />
                                <Button HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,2" Content="Cancel" AutomationProperties.Name="Cancel flyout sign-in"
                                        Command="{Binding DataContext.CancelSignInCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding StatusText}" AutomationProperties.Name="Profile status"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                    <Button DockPanel.Dock="Bottom" Margin="0,6,0,0" HorizontalAlignment="Left" Padding="10,4" Content="Add profile…" Command="{Binding AddCommand}"
                            AutomationProperties.Name="Add profile" />
                    <ListBox ItemsSource="{Binding Profiles}" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Profile list">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2" AutomationProperties.Name="{Binding AutomationName}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource FlyoutLink}" Content="Re-authenticate" AutomationProperties.Name="{Binding DisplayName, StringFormat=Re-authenticate {0}}"
                                                Command="{Binding DataContext.AuthenticateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource FlyoutLink}" Content="Rename" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                                                AutomationProperties.Name="{Binding DisplayName, StringFormat=Rename {0}}"
                                                Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource FlyoutLink}" Content="Remove" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                                                AutomationProperties.Name="{Binding DisplayName, StringFormat=Remove {0}}"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding AuthText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Email, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
