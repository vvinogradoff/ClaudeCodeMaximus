<UserControl x:Class="TessynDesktop.WPF.Views.PreviewPanelContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TessynDesktop.WPF.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/TitleBarButtons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <!-- The panel's own buttons: the look of the preview window's title bar buttons, a little lower (FR.29.20) -->
            <Style x:Key="PanelToggle" TargetType="ToggleButton" BasedOn="{StaticResource BarIconToggle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            </Style>
            <Style x:Key="PanelIconButton" TargetType="Button" BasedOn="{StaticResource BarIconButton}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Margin" Value="0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- FR.29.20, FR.29.14: a compact row at the top of the panel: the file's Source and Open in default app on the left, Pin and Auto-close on the right.
             The title is on the panel's tab and header. Buttons keep their places, the content below stretches (NR.7). -->
        <Grid x:Name="ButtonRow" Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}" TextElement.Foreground="{DynamicResource TitleBarForegroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ToggleButton x:Name="SourceButton" Style="{StaticResource PanelToggle}" IsChecked="{Binding File.ShowSource, Mode=TwoWay}"
                              Visibility="{Binding File.CanToggleSource, FallbackValue=Collapsed, Converter={StaticResource BoolToVis}}" ToolTip="Show the source">
                    <TextBlock Style="{StaticResource IconText}" Text="{StaticResource GlyphCode}" />
                </ToggleButton>
                <Button x:Name="OpenExternalButton" Style="{StaticResource PanelIconButton}" Command="{Binding File.OpenExternalCommand}"
                        Visibility="{Binding File.CanOpenExternally, FallbackValue=Collapsed, Converter={StaticResource BoolToVis}}" ToolTip="Open in default app">
                    <TextBlock Style="{StaticResource IconText}" Text="{StaticResource GlyphOpenInNew}" />
                </Button>
            </StackPanel>
            <StackPanel x:Name="GroupButtons" Grid.Column="2" Orientation="Horizontal">
                <ToggleButton x:Name="PinButton" Style="{StaticResource PanelToggle}" IsChecked="{Binding PinChecked, Mode=TwoWay}" IsEnabled="{Binding CanAutoClose}" ToolTip="{Binding PinToolTip}">
                    <TextBlock Style="{StaticResource IconText}" Text="{StaticResource GlyphPin}" />
                </ToggleButton>
                <ToggleButton x:Name="AutoCloseButton" Style="{StaticResource PanelToggle}" IsChecked="{Binding AutoCloseChecked, Mode=TwoWay}"
                              Visibility="{Binding CanAutoClose, Converter={StaticResource BoolToVis}}" ToolTip="{Binding AutoCloseToolTip}">
                    <TextBlock Style="{StaticResource IconText}" Text="{StaticResource GlyphAutoClose}" />
                </ToggleButton>
            </StackPanel>
        </Grid>
        <v:PreviewContentHost x:Name="ContentView" Grid.Row="1" />
    </Grid>
</UserControl>
