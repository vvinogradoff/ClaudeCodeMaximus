<UserControl x:Class="TessynDesktop.WPF.Views.CommandBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TessynDesktop.WPF.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="OptionTemplate" DataType="{x:Type vm:SelectorOptionViewModel}">
            <TextBlock Text="{Binding ShortLabel}" ToolTip="{Binding Label}" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                <Setter Property="FontStyle" Value="Italic" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>
    <!-- Selectors of the session pane (W1a): model, effort, profile. The DataContext is the SessionPaneViewModel of the slot's host. -->
    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <ComboBox Width="220" Margin="0,0,8,0" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                  ItemTemplate="{StaticResource OptionTemplate}" ToolTip="Model" AutomationProperties.Name="Model" />
        <ComboBox Width="110" Margin="0,0,8,0" ItemsSource="{Binding Efforts}" SelectedItem="{Binding SelectedEffort, Mode=TwoWay}"
                  ItemTemplate="{StaticResource OptionTemplate}" ToolTip="Effort" AutomationProperties.Name="Effort" />
        <ComboBox Width="170" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                  ItemTemplate="{StaticResource OptionTemplate}" ToolTip="Profile" AutomationProperties.Name="Profile" />
    </StackPanel>
</UserControl>
