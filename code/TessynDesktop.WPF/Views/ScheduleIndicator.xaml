<UserControl x:Class="TessynDesktop.WPF.Views.ScheduleIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- One row of the list: what, when, and Cancel (a mailbox delivery has none). -->
            <DataTemplate x:Key="ScheduleRow">
                <Grid Margin="0,2" AutomationProperties.Name="{Binding AutomationName}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding PromptPreview}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        <TextBlock Text="{Binding WhenText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Cancel" Margin="12,0,0,0" VerticalAlignment="Center" Padding="8,3"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                            Command="{Binding Cancel}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding CancelAutomationName}" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Visibility="{Binding Schedules.HasSchedules, Converter={StaticResource BoolToVis}}">
        <!-- Icon only, in the side column of the input area; the tooltip names it and gives the count. -->
        <ToggleButton x:Name="IndicatorButton" Padding="8,6" HorizontalAlignment="Stretch" IsChecked="{Binding Schedules.IsOpen, Mode=TwoWay}"
                      ToolTip="{Binding Schedules.ToolTipText}" AutomationProperties.Name="Schedules">
            <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="{StaticResource GlyphClock}" />
        </ToggleButton>
        <Popup IsOpen="{Binding Schedules.IsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=IndicatorButton}" Placement="Left" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource ControlSolidFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="12" MinWidth="320" MaxWidth="460" Margin="8">
                <StackPanel>
                    <TextBlock Text="Scheduled" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Schedules.Own}" ItemTemplate="{StaticResource ScheduleRow}" AutomationProperties.Name="Schedule list" />
                    <StackPanel Visibility="{Binding Schedules.HasMailbox, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                        <TextBlock Text="Mailbox deliveries" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Schedules.Mailbox}" ItemTemplate="{StaticResource ScheduleRow}" AutomationProperties.Name="Mailbox deliveries" />
                    </StackPanel>
                    <TextBlock Text="{Binding Schedules.Status}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
