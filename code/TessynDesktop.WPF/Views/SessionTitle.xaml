<UserControl x:Class="TessynDesktop.WPF.Views.SessionTitle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The title of the session header: a Delete icon on its left (with the confirmation of the tree's Delete), the name, and a double click on the name turns it into a text box
         (Enter accepts, Esc cancels). DataContext: the session pane. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <Button x:Name="DeleteButton" DockPanel.Dock="Left" Margin="0,0,8,0" Padding="6,5" VerticalAlignment="Center" Click="OnDeleteClick" ToolTip="Delete this session"
                Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Delete session">
            <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE74D;" />
        </Button>
        <Grid>
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       ToolTip="Double-click to rename" MouseLeftButtonDown="OnTitleMouseDown" />
            <TextBox x:Name="RenameBox" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" MinWidth="260" FontSize="16" VerticalAlignment="Center"
                     Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Rename session"
                     PreviewKeyDown="OnRenameKeyDown" LostKeyboardFocus="OnRenameLostFocus" IsVisibleChanged="OnRenameVisibleChanged" />
        </Grid>
    </DockPanel>
</UserControl>
