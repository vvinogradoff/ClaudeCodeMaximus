<Window x:Class="TessynDesktop.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:TessynDesktop.WPF.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Tessyn" Width="1280" Height="800" MinWidth="640" MinHeight="400">
    <!-- The custom title bar (W10a): the caption is the empty part of the TitleBar, the frame stays resizable -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/Icons.xaml" /></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="Root">
    <DockPanel>
        <v:TitleBar x:Name="TitleBarView" DockPanel.Dock="Top" />
        <Border DockPanel.Dock="Top" Padding="16,8" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding Connection.IsBannerVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconText}" Text="{StaticResource GlyphWarning}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Connection.BannerText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Connection.Detail, StringFormat=  ({0})}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
        <!-- The daemon runs an older build than the newest host build: one click restarts it (asks first) -->
        <Border DockPanel.Dock="Top" Padding="16,6" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding Connection.IsDaemonOlder, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Connection.DaemonOlderText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="Restart daemon" Command="{Binding Connection.RestartDaemonCommand}" Margin="12,0,0,0" Padding="10,2" />
                <TextBlock Text="{Binding Connection.RestartNote, StringFormat=  ({0})}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}" />
            <StatusBarItem Content="{Binding ErrorText}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            <!-- Slot: items at the right of the status bar -->
            <StatusBarItem DockPanel.Dock="Right">
                <v:SlotHost SlotId="main.statusBarItems">
                    <v:SlotHost.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </v:SlotHost.ItemsPanel>
                </v:SlotHost>
            </StatusBarItem>
        </StatusBar>
        <Grid x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="320" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <!-- Left panel: the Tree tab, plus the tabs later packages contribute (Recent, Tags); the tab strip stays hidden until one exists -->
            <v:SlotTabControl Grid.Column="0" x:Name="LeftTabs" SlotId="main.leftPanelTabs" Padding="0" BorderThickness="0" Background="Transparent">
                <TabItem Header="Tree">
                    <v:TreePanel DataContext="{Binding Tree}" />
                </TabItem>
            </v:SlotTabControl>
            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
            <v:SessionPane Grid.Column="2" DataContext="{Binding Session}" />
        </Grid>
    </DockPanel>
    <!-- The screensaver covers everything, the title bar included -->
    <v:ScreensaverOverlay x:Name="Screensaver" />
    </Grid>
</Window>




