<Window x:Class="TessynDesktop.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:TessynDesktop.WPF.Views"
        Title="Tessyn" Width="1280" Height="800" MinWidth="640" MinHeight="400">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="10,5" Background="#FFF3CD"
                Visibility="{Binding Connection.IsBannerVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Connection.BannerText}" Foreground="#664D03" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Connection.Detail, StringFormat=  ({0})}" Foreground="#664D03" Opacity="0.7" />
            </StackPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}" />
        </StatusBar>
        <Grid x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="320" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <v:TreePanel Grid.Column="0" DataContext="{Binding Tree}" />
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
            <ContentControl Grid.Column="2" x:Name="SessionHost" />
        </Grid>
    </DockPanel>
</Window>
