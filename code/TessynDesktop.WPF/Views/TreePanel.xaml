<UserControl x:Class="TessynDesktop.WPF.Views.TreePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TessynDesktop.WPF.ViewModels"
             xmlns:v="clr-namespace:TessynDesktop.WPF.Views">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/Icons.xaml" /><ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/TreeRowStyles.xaml" /></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <v:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVis" />
        <Style x:Key="ExpanderButton" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="4" Background="Transparent">
                            <TextBlock x:Name="Chevron" Style="{StaticResource IconText}" FontSize="10" Text="{StaticResource GlyphChevronRight}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate DataType="{x:Type vm:TreeNodeViewModel}">
            <Grid MinHeight="26" ToolTip="{Binding ToolTipText}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Drag feedback: a session over a row that may take it lights up in the accent colour, over one that may not in the critical colour. -->
                <Border Grid.ColumnSpan="4" CornerRadius="4" IsHitTestVisible="False" Opacity="0.3" Visibility="Collapsed">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DropFeedback}" Value="Allowed">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DropFeedback}" Value="Refused">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Width="{Binding IndentWidth}" />
                <Button Grid.Column="1" Style="{StaticResource ExpanderButton}"
                        Visibility="{Binding CanExpand, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding}" />
                <!-- A directory or a group: its label (a directory in bold). -->
                <TextBlock Grid.Column="2" Text="{Binding Label}" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                           Visibility="{Binding IsSessionLike, Converter={StaticResource InvertedBoolToVis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Group">
                                    <Setter Property="FontWeight" Value="Normal" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- A session or a worker: the shared row face (status squares, name, profile and date below it, recency colour). -->
                <v:SessionRowFace Grid.Column="2" Visibility="{Binding IsSessionLike, Converter={StaticResource BoolToVis}}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GitOriginLabel}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,8,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="140" Visibility="{Binding HasGitOrigin, Converter={StaticResource BoolToVis}}" />
                    <!-- ISSUE.013 R5: a caution mark when a worker runs on another profile than its supervisor. -->
                    <TextBlock Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0" Text="{StaticResource GlyphWarning}" ToolTip="{Binding ProfileToolTip}"
                               AutomationProperties.Name="Profile badge" Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding HasProfileMismatch, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding MatchSummary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding WorkerCount, StringFormat={}{0}w}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding CanExpand}" Value="True" />
                                            <Condition Binding="{Binding IsSessionLike}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>    </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <!-- Slots: the toolbar (Add directory, New session, New group, Refresh) in one line at the bottom of the panel, a footer above it -->
        <v:SlotHost DockPanel.Dock="Bottom" SlotId="tree.toolbar" />
        <v:SlotHost DockPanel.Dock="Bottom" SlotId="tree.footer" />
        <Grid DockPanel.Dock="Top" Margin="8,8,8,4">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search sessions" Padding="8,5,30,5" />
            <TextBlock Style="{StaticResource IconText}" Text="{StaticResource GlyphSearch}" FontSize="12" HorizontalAlignment="Right"
                       Margin="0,0,10,0" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Margin="12,0,12,4" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding StatusText}" />
        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource TreeRowItem}"
                 BorderThickness="0" Background="Transparent"
                 v:CommandMenu.Menu="tree.node"
                 x:Name="RowList"
                 PreviewKeyDown="OnTreeKeyDown"
                 ToolTipOpening="OnRowToolTipOpening"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
    </DockPanel>
</UserControl>


