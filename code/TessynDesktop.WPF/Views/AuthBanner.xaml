<UserControl x:Class="TessynDesktop.WPF.Views.AuthBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <!-- DataContext: AuthBannerViewModel (set by the module). -->
    <Border Margin="8,4" Padding="10,6" CornerRadius="4" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Auth error banner">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Re-authenticate" Padding="8,3" Margin="8,0,0,0" Command="{Binding ReauthenticateCommand}" AutomationProperties.Name="Re-authenticate" />
                <Button Content="Remove" Padding="8,3" Margin="6,0,0,0" Command="{Binding RemoveCommand}" AutomationProperties.Name="Remove profile" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                <Run Text="{Binding Text, Mode=OneWay}" /> <Run FontWeight="SemiBold" Text="{Binding ProfileName, Mode=OneWay}" />
            </TextBlock>
        </DockPanel>
    </Border>
</UserControl>
