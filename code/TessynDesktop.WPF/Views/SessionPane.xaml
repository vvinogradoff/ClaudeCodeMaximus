<UserControl x:Class="TessynDesktop.WPF.Views.SessionPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TessynDesktop.WPF.ViewModels"
             xmlns:v="clr-namespace:TessynDesktop.WPF.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/Icons.xaml" /></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <v:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVis" />
        <v:BoolToGridLengthConverter x:Key="BoolToStarLength" />
    </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding ShowFindCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: name, state, tag chips -->
        <StackPanel Grid.Row="0" Margin="16,10,16,8">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" Margin="0,0,10,0" Padding="8,6" ToolTip="Back to where you were"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Back">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphBack}" />
                        <TextBlock Text="Back" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Command="{Binding ToggleSideCommand}" Margin="8,0,0,0" Padding="8,6" ToolTip="Show or hide the Focus pane"
                        Visibility="{Binding HasSideContent, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Focus pane">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphPin}" />
                        <TextBlock Text="Focus" Margin="6,0,0,0" />
                        <TextBlock Text="{Binding FocusBadge, StringFormat={}({0})}" Margin="4,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FocusBadge}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <!-- Slot: buttons at the right of the header -->
                <v:SlotHost DockPanel.Dock="Right" SlotId="session.headerToolbar">
                    <v:SlotHost.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </v:SlotHost.ItemsPanel>
                </v:SlotHost>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StateText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Tags}" Margin="0,4,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SessionTagViewModel}">
                        <Button Command="{Binding OpenCommand}" Margin="0,0,6,4" Padding="8,3" ToolTip="{Binding Url}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding KindText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Label}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- A failed page of newer entries: no automatic retry; scroll again or press Retry -->
            <Border Margin="0,6,0,0" Padding="10,6" CornerRadius="4" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    Visibility="{Binding NewerFailed, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding RetryNewerCommand}" Content="Retry" Padding="10,2" Margin="8,0,0,0" AutomationProperties.Name="Retry loading newer entries" />
                    <TextBlock Text="Could not load newer entries" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Non-blocking notice (a failed jump or preview) -->
            <Border Margin="0,6,0,0" Padding="10,6" CornerRadius="4" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding DismissNoticeCommand}" Padding="6,2" Margin="8,0,0,0" ToolTip="Dismiss" AutomationProperties.Name="Dismiss message">
                        <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="{StaticResource GlyphClose}" />
                    </Button>
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Find bar (WebView2 cannot be overlapped, so it lives in its own row) -->
        <DockPanel Grid.Row="1" Margin="16,0,16,8" Visibility="{Binding FindBarVisible, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Right" Command="{Binding CloseFindCommand}" ToolTip="Close (Esc)" Margin="2,0,0,0" Padding="8,6" AutomationProperties.Name="Close find">
                <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphClose}" />
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding FindNextCommand}" ToolTip="Next (F3)" Margin="2,0" Padding="8,6" AutomationProperties.Name="Find next">
                <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphChevronDown}" />
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding FindPreviousCommand}" ToolTip="Previous (Shift+F3)" Margin="2,0" Padding="8,6" AutomationProperties.Name="Find previous">
                <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphChevronUp}" />
            </Button>
            <TextBlock DockPanel.Dock="Right" Text="{Binding FindStatus}" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="FindBox" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnFindKeyDown" />
        </DockPanel>

        <!-- Transcript -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SideColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" x:Name="TranscriptHost">
                <wv2:WebView2 x:Name="Transcript" />
            </Grid>

            <!-- Side pane: the Focus view, and below it the file preview while one is open (WebView2 cannot be overlapped, so it has its own cell). -->
            <GridSplitter Grid.Column="1" x:Name="SideSplitter" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Visibility="Collapsed" />
            <Grid Grid.Column="2" x:Name="SidePane" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{Binding Preview.IsOpen, Converter={StaticResource BoolToStarLength}, FallbackValue=0}" />
                </Grid.RowDefinitions>
                <v:FocusPanel Grid.Row="0" DataContext="{Binding Focus}" />
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Visibility="{Binding Preview.IsOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                <v:FilePreviewPane Grid.Row="2" DataContext="{Binding Preview}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
            </Grid>
        </Grid>

        <!-- Input -->
        <StackPanel Grid.Row="3" Margin="16,8,16,12">
        <!-- Slots: instruction toggles above the prompt box, accessories (autocomplete hints, draft and auth notices) right above it -->
        <v:SlotHost SlotId="session.instructionToolbar" />
        <v:SlotHost SlotId="session.composerAccessory" />
        <!-- Progress of a file-mode drop: one copy per file, cancellable -->
        <Border Margin="0,0,0,6" Padding="10,6" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding CancelImportCommand}" Content="Cancel" Padding="10,2" Margin="8,0,0,0"
                        ToolTip="Stop attaching files" AutomationProperties.Name="Cancel attaching" />
                <StackPanel>
                    <TextBlock Text="{Binding ImportStatus}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Attach progress" />
                    <ProgressBar Margin="0,4,0,0" Minimum="0" Maximum="{Binding ImportTotal}" Value="{Binding ImportDone}" Height="4" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="200" AllowDrop="True" AutomationProperties.Name="Prompt input"
                     VerticalScrollBarVisibility="Auto" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Ctrl+Enter sends. Drop or paste files here."
                     PreviewDragEnter="OnInputDragOver" PreviewDragOver="OnInputDragOver" PreviewDrop="OnInputDrop"
                     TextChanged="OnInputEdited" SelectionChanged="OnInputEdited" PreviewKeyDown="OnInputPreviewKeyDown" LostKeyboardFocus="OnInputLostFocus">
                <TextBox.InputBindings>
                    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <!-- Autocomplete suggestions (W1b), placed at the caret by SessionPane.xaml.cs; the input box keeps the keyboard focus -->
            <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=InputBox}" Placement="Custom" StaysOpen="True" Focusable="False"
                   IsOpen="{Binding Autocomplete.IsOpen, Mode=OneWay}">
                <v:AutocompletePopup x:Name="Suggestions" DataContext="{Binding Autocomplete}" />
            </Popup>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
                <ToggleButton x:Name="FileModeToggle" IsChecked="{Binding AttachAsFiles, Mode=TwoWay}" Margin="0,0,0,4" Padding="8,6" HorizontalAlignment="Stretch"
                              ToolTip="File mode: dropped files are copied into this session's attachments and 'Attached file: path' is inserted. Off: the file's own path is inserted."
                              AutomationProperties.Name="File mode">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="{StaticResource GlyphAttach}" />
                        <TextBlock Text="File mode" Margin="8,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <Button Command="{Binding SendCommand}" Margin="0,0,0,4" Style="{DynamicResource AccentButtonStyle}" ToolTip="Send (Ctrl+Enter)" AutomationProperties.Name="Send">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="{StaticResource GlyphSend}" />
                        <TextBlock Text="Send" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding StopCommand}" ToolTip="Stop the running turn" AutomationProperties.Name="Stop">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="{StaticResource GlyphStop}" />
                        <TextBlock Text="Stop" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <!-- Slot: command bar below the prompt box (model, effort and profile selectors, toggles) -->
        <v:SlotHost SlotId="session.commandBar" />
        </StackPanel>
    </Grid>
</UserControl>



