<UserControl x:Class="TessynDesktop.WPF.Views.SessionPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TessynDesktop.WPF.ViewModels"
             xmlns:v="clr-namespace:TessynDesktop.WPF.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/Icons.xaml" /></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <v:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVis" />
        <v:BoolToGridLengthConverter x:Key="BoolToStarLength" />

        <!-- The Session / Focus switch (FR.23.12): two radio buttons drawn as one segmented control; a click on the checked side changes nothing. -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The prompt box: the full text box when expanded, one line (no wrapping, scrolls sideways) when the input area is collapsed (FR.12.29). -->
        <Style x:Key="PromptBox" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInputCollapsed}" Value="True">
                    <Setter Property="TextWrapping" Value="NoWrap" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Height" Value="34" />
                    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+F" Command="{Binding ShowFindCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="InputRow" Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: name, state, tag chips -->
        <StackPanel Grid.Row="0" Margin="16,10,16,8">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" Margin="0,0,10,0" Padding="8,6" ToolTip="Back to where you were"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Back">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphBack}" />
                        <TextBlock Text="Back" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Command="{Binding ToggleSideCommand}" Margin="8,0,0,0" Padding="8,6" ToolTip="Show or hide the preview pane"
                        Visibility="{Binding HasSideContent, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Preview pane">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphFile}" />
                        <TextBlock Text="Preview" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <!-- Session / Focus switch (FR.23.12): exactly one side is checked; the Focus badge shows while Session is selected (FR.23.13) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <RadioButton x:Name="SessionViewButton" GroupName="SessionFocusView" Style="{StaticResource SegmentButton}" Content="Session"
                                 IsChecked="{Binding IsSessionSelected, Mode=OneWay}" Command="{Binding SelectSessionViewCommand}" Checked="OnSessionViewChecked"
                                 AutomationProperties.Name="Session view" ToolTip="Show the transcript" />
                    <RadioButton x:Name="FocusViewButton" GroupName="SessionFocusView" Style="{StaticResource SegmentButton}" Margin="2,0,0,0"
                                 IsChecked="{Binding IsFocusSelected, Mode=OneWay}" Command="{Binding SelectFocusViewCommand}" Checked="OnFocusViewChecked"
                                 AutomationProperties.Name="Focus view" ToolTip="Show what needs your attention">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Focus" />
                            <TextBlock x:Name="FocusBadgeText" Text="{Binding FocusBadge, StringFormat={}({0})}" Margin="4,0,0,0"
                                       Visibility="{Binding IsFocusBadgeVisible, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Focus badge" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <!-- Slot: buttons at the right of the header -->
                <v:SlotHost DockPanel.Dock="Right" SlotId="session.headerToolbar">
                    <v:SlotHost.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </v:SlotHost.ItemsPanel>
                </v:SlotHost>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StateText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
            <v:SessionTagArea DataContext="{Binding TagArea}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- A failed page of newer entries: no automatic retry; scroll again or press Retry -->
            <Border Margin="0,6,0,0" Padding="10,6" CornerRadius="4" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    Visibility="{Binding NewerFailed, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding RetryNewerCommand}" Content="Retry" Padding="10,2" Margin="8,0,0,0" AutomationProperties.Name="Retry loading newer entries" />
                    <TextBlock Text="Could not load newer entries" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Non-blocking notice (a failed jump or preview) -->
            <Border Margin="0,6,0,0" Padding="10,6" CornerRadius="4" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding DismissNoticeCommand}" Padding="6,2" Margin="8,0,0,0" ToolTip="Dismiss" AutomationProperties.Name="Dismiss message">
                        <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="{StaticResource GlyphClose}" />
                    </Button>
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Find bar (WebView2 cannot be overlapped, so it lives in its own row) -->
        <DockPanel Grid.Row="1" Margin="16,0,16,8" Visibility="{Binding FindBarVisible, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Right" Command="{Binding CloseFindCommand}" ToolTip="Close (Esc)" Margin="2,0,0,0" Padding="8,6" AutomationProperties.Name="Close find">
                <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphClose}" />
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding FindNextCommand}" ToolTip="Next (F3)" Margin="2,0" Padding="8,6" AutomationProperties.Name="Find next">
                <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphChevronDown}" />
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding FindPreviousCommand}" ToolTip="Previous (Shift+F3)" Margin="2,0" Padding="8,6" AutomationProperties.Name="Find previous">
                <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphChevronUp}" />
            </Button>
            <TextBlock DockPanel.Dock="Right" Text="{Binding FindStatus}" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="FindBox" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnFindKeyDown" />
        </DockPanel>

        <!-- Transcript -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SideColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" x:Name="TranscriptHost" Visibility="{Binding IsFocusSelected, Converter={StaticResource InvertedBoolToVis}}">
                <wv2:WebView2 x:Name="Transcript" />
            </Grid>
            <!-- The Focus view replaces the transcript while it is selected (FR.23.12); the transcript is hidden, not unloaded -->
            <Grid Grid.Column="0" x:Name="FocusHost" Visibility="{Binding IsFocusSelected, Converter={StaticResource BoolToVis}}">
                <v:FocusPanel x:Name="FocusView" DataContext="{Binding Focus}" />
            </Grid>

            <!-- Side pane: the file preview while one is open (WebView2 cannot be overlapped, so it has its own cell). -->
            <GridSplitter Grid.Column="1" x:Name="SideSplitter" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Visibility="Collapsed" />
            <Grid Grid.Column="2" x:Name="SidePane" Visibility="Collapsed">
                <v:FilePreviewPane DataContext="{Binding Preview}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
            </Grid>
        </Grid>

        <!-- The splitter that sets the height of the input area; a double click collapses or expands it (FR.12.29) -->
        <GridSplitter Grid.Row="3" x:Name="InputSplitter" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Cursor="SizeNS"
                      AutomationProperties.Name="Input area splitter" ToolTip="Drag to resize. Double-click (or Enter) to collapse or expand the input area."
                      PreviewMouseLeftButtonDown="OnInputSplitterMouseDown" PreviewKeyDown="OnInputSplitterKeyDown" DragStarted="OnInputSplitterDragStarted" DragDelta="OnInputSplitterDragDelta" DragCompleted="OnInputSplitterDragCompleted" />

        <!-- Input: expanded (FR.12.1/12.2) or collapsed (FR.12.29: the command bar only while it is shown, otherwise one line of text) -->
        <!-- The content fills the row the splitter sets: the prompt grid takes the remaining height (the text box stretches); when the row is smaller than the content it scrolls. -->
        <ScrollViewer Grid.Row="4" x:Name="InputScroll" Margin="16,2,16,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid x:Name="InputContent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
        <!-- Slots: instruction toggles above the prompt box, accessories (autocomplete hints, draft and auth notices) right above it -->
        <v:SlotHost SlotId="session.instructionToolbar" Visibility="{Binding ShowExpandedExtras, Converter={StaticResource BoolToVis}}" />
        <v:SlotHost SlotId="session.composerAccessory" />
        <!-- Progress of a file-mode drop: one copy per file, cancellable -->
        <Border Margin="0,0,0,6" Padding="10,6" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding CancelImportCommand}" Content="Cancel" Padding="10,2" Margin="8,0,0,0"
                        ToolTip="Stop attaching files" AutomationProperties.Name="Cancel attaching" />
                <StackPanel>
                    <TextBlock Text="{Binding ImportStatus}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Attach progress" />
                    <ProgressBar Margin="0,4,0,0" Minimum="0" Maximum="{Binding ImportTotal}" Value="{Binding ImportDone}" Height="4" />
                </StackPanel>
            </DockPanel>
        </Border>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DockPanel x:Name="InputBody" LastChildFill="True" MaxHeight="260">
                <!-- Slot: command bar below the prompt box (model, effort and profile selectors, toggles) -->
                <v:SlotHost DockPanel.Dock="Bottom" SlotId="session.commandBar" Visibility="{Binding IsCommandBarVisible, Converter={StaticResource BoolToVis}}" />
                <TextBox x:Name="InputBox" Style="{StaticResource PromptBox}" AllowDrop="True" AutomationProperties.Name="Prompt input"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding ShowInputBox, Converter={StaticResource BoolToVis}}"
                         ToolTip="Ctrl+Enter sends. Drop or paste files here."
                         PreviewDragEnter="OnInputDragOver" PreviewDragOver="OnInputDragOver" PreviewDrop="OnInputDrop"
                         TextChanged="OnInputEdited" SelectionChanged="OnInputEdited" PreviewKeyDown="OnInputPreviewKeyDown" LostKeyboardFocus="OnInputLostFocus">
                    <TextBox.InputBindings>
                        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <!-- Autocomplete suggestions (W1b), placed at the caret by SessionPane.xaml.cs; the input box keeps the keyboard focus -->
            <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=InputBox}" Placement="Custom" StaysOpen="True" Focusable="False"
                   IsOpen="{Binding Autocomplete.IsOpen, Mode=OneWay}">
                <v:AutocompletePopup x:Name="Suggestions" DataContext="{Binding Autocomplete}" />
            </Popup>
            <!-- The side column: expanded it holds the file-mode and settings toggles, Send, and Stop while a turn runs; collapsed it holds exactly one button, Send or Stop -->
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
                <ToggleButton x:Name="FileModeToggle" IsChecked="{Binding AttachAsFiles, Mode=TwoWay}" Margin="0,0,0,4" Padding="8,6" HorizontalAlignment="Stretch"
                              Visibility="{Binding ShowExpandedExtras, Converter={StaticResource BoolToVis}}"
                              ToolTip="File mode: dropped files are copied into this session's attachments and 'Attached file: path' is inserted. Off: the file's own path is inserted."
                              AutomationProperties.Name="File mode">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="{StaticResource GlyphAttach}" />
                        <TextBlock Text="File mode" Margin="8,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="SettingsToggle" IsChecked="{Binding IsCommandBarVisible, Mode=TwoWay}" Margin="0,0,0,4" Padding="8,6" HorizontalAlignment="Stretch"
                              Visibility="{Binding ShowExpandedExtras, Converter={StaticResource BoolToVis}}"
                              ToolTip="Show or hide the settings bar (model, effort, profile)" AutomationProperties.Name="Settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="{StaticResource GlyphSettings}" />
                        <TextBlock Text="Settings" Margin="8,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="SendButton" Command="{Binding SendCommand}" PreviewMouseRightButtonUp="OnSendRightClick" Margin="0,0,0,4" Style="{DynamicResource AccentButtonStyle}" ToolTip="Send (Ctrl+Enter)" AutomationProperties.Name="Send"
                        Visibility="{Binding ShowSendButton, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="{StaticResource GlyphSend}" />
                        <TextBlock Text="Send" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopButton" Command="{Binding StopCommand}" ToolTip="Stop the running turn" AutomationProperties.Name="Stop"
                        Visibility="{Binding ShowStopButton, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="{StaticResource GlyphStop}" />
                        <TextBlock Text="Stop" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>



