<UserControl x:Class="TessynDesktop.WPF.Views.ProfileSwitchButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: TreeViewModel (the tree.footer slot). The button acts on the selected node, as the tree toolbar does; the status line under it is the switch's. -->
    <StackPanel x:Name="Root">
        <Button Margin="8,4,8,2" Padding="8,4" FontSize="12" HorizontalAlignment="Left" Content="Switch profile…" Click="OnClick"
                AutomationProperties.Name="Switch profile" ToolTip="Move the selected session, and optionally its workers, to another profile" />
        <TextBlock x:Name="Status" Margin="10,0,8,6" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   AutomationProperties.Name="Profile switch status" />
    </StackPanel>
</UserControl>
