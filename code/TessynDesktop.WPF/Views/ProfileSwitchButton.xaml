<UserControl x:Class="TessynDesktop.WPF.Views.ProfileSwitchButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: the session pane (the session.headerToolbar slot, right of "Send later"). The button acts on the open session; the status line beside it is the switch's. -->
    <StackPanel x:Name="Root" Orientation="Horizontal">
        <Button Margin="8,0,0,0" Padding="8,4" Content="Switch profile…" Click="OnClick" VerticalAlignment="Center"
                AutomationProperties.Name="Switch profile" ToolTip="Move this session, and optionally its workers, to another profile" />
        <TextBlock x:Name="Status" Margin="8,0,0,0" MaxWidth="220" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                   AutomationProperties.Name="Profile switch status" />
    </StackPanel>
</UserControl>
