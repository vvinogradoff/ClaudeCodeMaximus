<UserControl x:Class="TessynDesktop.WPF.Views.RecentDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/SessionListStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="Toggle" Margin="8,4" Padding="10,4" AutomationProperties.Name="Recent dropdown" ToolTip="Recent sessions"
                      IsChecked="{Binding IsOpen, ElementName=Menu, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Recent" />
                <TextBlock Style="{StaticResource IconText}" FontSize="10" Margin="6,0,0,0" Text="{StaticResource GlyphChevronDown}" />
            </StackPanel>
        </ToggleButton>
        <Popup x:Name="Menu" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" StaysOpen="False" ButtonBase.Click="OnRowClick" Opened="OnOpened">
            <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                    Padding="4" MinWidth="320" MaxHeight="480">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="8,6" Text="{Binding EmptyText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource SessionListBoolToVis}}" />
                    <ListBox ItemsSource="{Binding Rows}" Style="{StaticResource SessionFlatListBox}" MaxHeight="460" />
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
