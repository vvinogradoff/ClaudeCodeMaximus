<UserControl x:Class="TessynDesktop.WPF.Views.RecentDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/SessionListStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The header button keeps its own look while the list is open (a Fluent checked toggle turns accent blue); open is shown by a faint fill. -->
            <Style x:Key="RecentToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <!-- The button's own Background (the recency tier of the open session) stays; hover and open lay a faint overlay over it instead of replacing it. -->
                                <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="Overlay" CornerRadius="4" IsHitTestVisible="False" Visibility="Collapsed" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Opacity="0.6" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Overlay" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Overlay" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- The open session's recency tier (FR.9.5) behind its name, the same colours as its row; off with the Appearance setting (RecencyLevel is 0 then). -->
                    <DataTrigger Binding="{Binding RecencyLevel}" Value="1"><Setter Property="Background" Value="{DynamicResource Colour.RecentTier4}" /></DataTrigger>
                    <DataTrigger Binding="{Binding RecencyLevel}" Value="2"><Setter Property="Background" Value="{DynamicResource Colour.RecentTier3}" /></DataTrigger>
                    <DataTrigger Binding="{Binding RecencyLevel}" Value="3"><Setter Property="Background" Value="{DynamicResource Colour.RecentTier2}" /></DataTrigger>
                    <DataTrigger Binding="{Binding RecencyLevel}" Value="4"><Setter Property="Background" Value="{DynamicResource Colour.RecentTier1}" /></DataTrigger>
                </Style.Triggers>
            </Style>        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <!-- Fills the width it is given (the title bar's middle); the label is the open session's name, "Recent" with none. -->
        <ToggleButton x:Name="Toggle" Style="{StaticResource RecentToggle}" Margin="0,2" Padding="10,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Recent dropdown" ToolTip="Recent sessions"
                      IsChecked="{Binding IsOpen, ElementName=Menu, Mode=TwoWay}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconText}" FontSize="10" Margin="6,0,0,0" Text="{StaticResource GlyphChevronDown}" />
                <!-- The open session's active workers badge (FR.1.28), left of the chevron. -->
                <Border x:Name="WorkersBadge" DockPanel.Dock="Right" Style="{StaticResource ActiveWorkersBadge}" Margin="6,0,0,0" AutomationProperties.Name="Active workers">
                    <TextBlock Style="{StaticResource ActiveWorkersBadgeText}" />
                </Border>
                <TextBlock x:Name="Label" Text="{Binding ButtonText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </ToggleButton>
        <Popup x:Name="Menu" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" StaysOpen="False" ButtonBase.Click="OnRowClick" Opened="OnOpened">
            <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1"
                    Padding="4" MinWidth="320" Width="{Binding ActualWidth, ElementName=Toggle}" MaxHeight="480">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="8,6" Text="{Binding EmptyText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource SessionListBoolToVis}}" />
                    <ListBox ItemsSource="{Binding Rows}" Style="{StaticResource SessionFlatListBox}" ItemTemplate="{StaticResource DropdownRowTemplate}" MaxHeight="460" />
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
