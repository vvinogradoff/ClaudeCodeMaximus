<UserControl x:Class="TessynDesktop.WPF.Views.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:v="clr-namespace:TessynDesktop.WPF.Views"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <v:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVis" />
            <!-- Flat caption button: the colour of the title bar, a hover tint, no focus rectangle -->
            <Style x:Key="CaptionButton" TargetType="Button">
                <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Width" Value="46" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource TitleBarHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource TitleBarHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                <Setter Property="Width" Value="36" />
            </Style>
            <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="White" />
                    </Trigger>
                </Style.Triggers>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource TitleBarCloseHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Height="32" Background="{DynamicResource TitleBarBackgroundBrush}" TextElement.Foreground="{DynamicResource TitleBarForegroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- Left: chevron, menu, day/night, then the toolbar slot (the instruction toolbar); the Recent dropdown takes the space left in the middle column -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="TreeToggle" Style="{StaticResource ToolButton}" Command="{Binding ToggleTreeCommand}" ToolTip="Show or hide the session tree"
                    AutomationProperties.Name="Toggle session tree">
                <Grid>
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE76B;" Visibility="{Binding IsTreeVisible, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE76C;" Visibility="{Binding IsTreeVisible, Converter={StaticResource InvertedBoolToVis}}" />
                </Grid>
            </Button>
            <Button x:Name="MenuButton" Style="{StaticResource ToolButton}" Click="OnMenuClick" ToolTip="Menu" AutomationProperties.Name="Main menu">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE700;" />
            </Button>
            <!-- The hamburger menu: a popup of flat buttons (not MenuItems: UI Automation cannot invoke the items of a WPF menu popup reliably), filled afresh each time it opens.
                 The entries come from the command registry (menu "main.menu"); Exit is always last. See OnMenuClick. -->
            <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=MenuButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="False">
                <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="2" MinWidth="200"
                        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <ItemsControl x:Name="MenuEntries" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Separator Visibility="{Binding BeginsGroup, Converter={StaticResource BoolToVis}}" Margin="2,2" />
                                    <Button Click="OnMenuEntryClick" Tag="{Binding CommandId}" IsEnabled="{Binding IsEnabled}" AutomationProperties.Name="{Binding Title}"
                                            Background="Transparent" BorderThickness="0" Padding="12,5" HorizontalContentAlignment="Stretch" Focusable="True">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Margin="24,0,0,0" Text="{Binding Gesture}" Opacity="0.6" />
                                            <TextBlock Text="{Binding Title}" />
                                        </DockPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>
            <Button x:Name="ThemeToggle" Style="{StaticResource ToolButton}" Command="{Binding ToggleThemeCommand}" ToolTip="Toggle light/dark theme"
                    AutomationProperties.Name="Toggle theme">
                <Grid>
                    <!-- Sun while dark (click for light), moon while light (click for dark) -->
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE706;" Visibility="{Binding IsDark, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE708;" Visibility="{Binding IsDark, Converter={StaticResource InvertedBoolToVis}}" />
                </Grid>
            </Button>
            <Border Width="1" Height="18" Margin="4,0" Background="{DynamicResource TitleBarSubtleBrush}" Opacity="0.5" />
            <!-- Slot: toolbar items contributed by other packages; they keep the main window's DataContext -->
            <v:SlotHost x:Name="ToolbarSlot" SlotId="main.titleBarToolbar" VerticalAlignment="Center"
                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <v:SlotHost.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </v:SlotHost.ItemsPanel>
            </v:SlotHost>
        </StackPanel>
        <!-- Middle: the Recent dropdown fills all the width between the toolbar and the build stamp; the right margin keeps some caption to drag the window by -->
        <v:SlotHost x:Name="CenterSlot" Grid.Column="1" SlotId="main.titleBarCenter" VerticalAlignment="Center" Margin="4,0,48,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <v:SlotHost.ItemContainerStyle>
                <Style TargetType="ContentControl">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="IsTabStop" Value="False" />
                </Style>
            </v:SlotHost.ItemContainerStyle>
        </v:SlotHost>
        <!-- Right: build stamp and the window buttons; the empty middle and the build stamp are the caption the window is dragged by (only the buttons are hit-testable in the chrome) -->
        <StackPanel Grid.Column="2" Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconText}" Text="{StaticResource GlyphWarning}" Foreground="Orange" Margin="0,0,6,0"
                       Visibility="{Binding IsBuildOutput, Converter={StaticResource BoolToVis}}" ToolTip="{Binding BuildOutputWarning}"
                       AutomationProperties.Name="Running from build output" />
            <TextBlock x:Name="BuildNumberText" Text="{Binding BuildNumber}" VerticalAlignment="Center" FontSize="10" Margin="0,0,10,0" Focusable="False"
                       Foreground="{DynamicResource TitleBarSubtleBrush}" AutomationProperties.Name="Build number" />
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="OnMinimizeClick" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE921;" />
            </Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="OnMaximizeClick" ToolTip="Maximize" AutomationProperties.Name="Maximize">
                <TextBlock x:Name="MaximizeGlyph" Style="{StaticResource IconText}" FontSize="10" Text="&#xE922;" />
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Click="OnCloseClick" ToolTip="Close" AutomationProperties.Name="Close">
                <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE8BB;" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
