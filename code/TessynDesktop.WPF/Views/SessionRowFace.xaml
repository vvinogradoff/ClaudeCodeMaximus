<UserControl x:Class="TessynDesktop.WPF.Views.SessionRowFace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- What a session looks like in the tree and in the Recent and Tags lists, as in the Avalonia client: two status squares (upper: running, lower: resumable in Claude Code),
         the Focus count pill, the name, the unsent-draft pencil, the favourite star and the schedule clock; below the name the profile on the left and the date of the last
         prompt on the right. The background is the recency tier of the last activity, a dotted border marks the last 24 hours. DataContext: a TreeNodeViewModel or a SessionRowViewModel
         (the properties both have in common). The colours are the palette's (Settings, Colours). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/KindPill.xaml" />
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/RecencyTint.xaml" />
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/ActiveWorkersBadge.xaml" />
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/LimitWarning.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Style="{StaticResource RecencyTint}" MinHeight="34">
        <Grid>
            <Grid Margin="0,2,0,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" x:Name="FirstLine">
                    <Grid DockPanel.Dock="Left" Width="8" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" AutomationProperties.Name="Session status">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="8" />
                            <RowDefinition Height="8" />
                        </Grid.RowDefinitions>
                        <Rectangle Grid.Row="0" Width="8" Height="8" Fill="{DynamicResource Colour.StatusRunning}" ToolTip="Running"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Running" />
                        <Rectangle Grid.Row="1" Width="8" Height="8" Fill="{DynamicResource Colour.StatusResumable}" Opacity="0.7" ToolTip="Can be resumed in Claude Code"
                                   Visibility="{Binding IsResumable, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Resumable" />
                    </Grid>
                    <Border DockPanel.Dock="Left" Style="{StaticResource KindPill}" Tag="{Binding AttentionKey}" Margin="0,0,6,0" ToolTip="Open Focus items"
                            Visibility="{Binding HasAttention, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Focus items">
                        <TextBlock Text="{Binding AttentionCount}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- A worker's limits-error warning: all the way to the right of its name line, above the date (FR.1.29). -->
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource LimitWarningIcon}" Margin="6,0,0,0" AutomationProperties.Name="Limits error"
                               Visibility="{Binding ShowLimitOnNameLine, Converter={StaticResource BoolToVis}}" />
                    <TextBlock DockPanel.Dock="Right" FontSize="10" Margin="6,0,0,0" Opacity="0.7" Text="{Binding WorkerCountText}" ToolTip="Sessions this session supervises"
                               Visibility="{Binding HasWorkers, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Worker count" />
                    <!-- Left of the "N workers" total: the badge counts the workers running now. -->
                    <Border DockPanel.Dock="Right" Style="{StaticResource ActiveWorkersBadge}" Margin="6,0,0,0" AutomationProperties.Name="Active workers">
                        <TextBlock Style="{StaticResource ActiveWorkersBadgeText}" />
                    </Border>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconText}" FontSize="10" Margin="6,0,0,0" Text="&#xE735;" Foreground="Gold" ToolTip="Favourite"
                               Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Favourite mark" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconText}" FontSize="10" Margin="6,0,0,0" Text="{StaticResource GlyphClock}" ToolTip="This session has a schedule"
                               Opacity="0.7" Visibility="{Binding HasSchedules, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Schedule indicator" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource IconText}" FontSize="10" Margin="6,0,0,0" Text="&#xE70F;" Opacity="0.5" ToolTip="Has unsent text"
                               Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Unsent draft" />
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Grid Grid.Row="1" Margin="14,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <TextBlock Text="{Binding ProfileName}" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxWidth="150" AutomationProperties.Name="Profile" />
                        <TextBlock Text="{Binding SwitchingToProfileName, StringFormat=→ {0}}" FontSize="10" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="110"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding HasSwitching, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,0,0">
                        <!-- Left of the date (FR.1.29): the last turn ended with a usage or limits error. -->
                        <TextBlock Style="{StaticResource LimitWarningIcon}" Margin="0,0,5,0" AutomationProperties.Name="Limits error"
                                   Visibility="{Binding ShowLimitOnDateLine, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding LastPromptText}" FontSize="10" Opacity="0.7" AutomationProperties.Name="Last prompt" />
                    </StackPanel>
                </Grid>
            </Grid>
            <Rectangle Stroke="{DynamicResource Colour.ActiveBorder}" StrokeThickness="1" StrokeDashArray="3,2" RadiusX="3" RadiusY="3" Fill="Transparent" IsHitTestVisible="False"
                       Visibility="{Binding IsRecentlyActive, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Border>
</UserControl>
