<UserControl x:Class="TessynDesktop.WPF.Views.FocusPanel" x:Name="Panel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TessynDesktop.WPF.ViewModels"
             xmlns:v="clr-namespace:TessynDesktop.WPF.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/Icons.xaml" />
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/KindPill.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Kind chip: the pill of the Avalonia client (AttentionKindPill) in the palette's colours (Settings, Colours); the kind comes in the Tag. -->
            <Style x:Key="KindChip" TargetType="Border" BasedOn="{StaticResource KindPill}">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,1" />
            </Style>
            <Style x:Key="KindChipText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="RefGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Text" Value="{StaticResource GlyphLink}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="entry">
                        <Setter Property="Text" Value="{StaticResource GlyphEntry}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="file">
                        <Setter Property="Text" Value="{StaticResource GlyphFile}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding KindKey}" Value="critical">
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- references of an item (FR.23.18, FR.23.29): the open card shows them always, the closed card when it is expanded -->
            <DataTemplate x:Key="RefListTemplate" DataType="{x:Type vm:FocusItemViewModel}">
                <ItemsControl ItemsSource="{Binding Refs}" Margin="0,4,0,0" Visibility="{Binding HasRefs, Converter={StaticResource BoolToVis}}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FocusRefViewModel}">
                            <Button Command="{Binding OpenCommand}" ToolTip="{Binding ToolTip}" Margin="0,0,6,6" Padding="8,3" AutomationProperties.Name="{Binding Label}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource RefGlyph}" />

                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DataTemplate>
            <Style x:Key="ClosedRefs" TargetType="ContentControl">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="ContentTemplate" Value="{StaticResource RefListTemplate}" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBodyExpanded}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <DataTemplate x:Key="OpenCardTemplate" DataType="{x:Type vm:FocusItemViewModel}">

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <!-- kind chip and posted time; the id, title and body are one selectable text (FR.23.25) -->
                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                <Border DockPanel.Dock="Left" Style="{StaticResource KindChip}" Tag="{Binding KindKey}">
                                    <TextBlock Style="{StaticResource KindChipText}" Text="{Binding KindText}" />
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PostedText}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DockPanel>
                            <v:FocusCardText Item="{Binding}" />

                            <!-- references (FR.23.18) -->
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RefListTemplate}" Focusable="False" />

                            <!-- options, the recommendation last (FR.23.26): one vertical list of full-width buttons -->
                            <ItemsControl ItemsSource="{Binding Options}" Margin="0,6,0,4" Visibility="{Binding HasOptions, Converter={StaticResource BoolToVis}}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <!-- An answer button: as wide as the card, text left, 2 px between buttons (FR.23.26); the recommendation is an accent button, like Send answers and Send (FR.23.28). -->
                                    <DataTemplate DataType="{x:Type vm:FocusOptionViewModel}">
                                        <Button x:Name="OptionButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,2" Padding="10,4"
                                                Command="{Binding PickCommand}" ToolTip="{Binding ToolTip}">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                                <Setter TargetName="OptionButton" Property="Style" Value="{DynamicResource AccentButtonStyle}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- free-text answer: a 2 px accent border and a resize grip at the bottom right (FR.23.28) -->
                            <Border x:Name="ReplyFrame" BorderThickness="2" CornerRadius="4" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                                <Grid>
                                    <TextBox x:Name="ReplyBox" Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="600"
                                             BorderThickness="0" VerticalScrollBarVisibility="Auto" ToolTip="Your answer; sent with Reply or Send answers" AutomationProperties.Name="Your answer" />
                                    <Thumb x:Name="ReplyGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" Cursor="SizeNWSE"
                                           DragDelta="OnReplyGripDragDelta" ToolTip="Drag to resize" AutomationProperties.Name="Resize the answer box">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <ResizeGrip Background="Transparent" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                            </Border>
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Command="{Binding DismissCommand}" Content="{Binding CloseText}" ToolTip="Closes the item without sending anything" />
                                <Button HorizontalAlignment="Left" Command="{Binding ReplyCommand}" Content="Reply" Style="{DynamicResource AccentButtonStyle}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
            </DataTemplate>

            <!-- Closed card (FR.23.14): compact, header row plus the outcome line; a click on the header shows or hides the body. -->
            <DataTemplate x:Key="ClosedCardTemplate" DataType="{x:Type vm:FocusItemViewModel}">
                <Border Style="{StaticResource CardBorder}" Padding="12,8" PreviewMouseLeftButtonDown="OnClosedCardDown" PreviewMouseLeftButtonUp="OnClosedCardUp">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Background="Transparent" Cursor="Hand" ToolTip="Show or hide the details" Margin="0,0,0,6"
                                   AutomationProperties.Name="Closed item header">
                            <Border DockPanel.Dock="Left" Style="{StaticResource KindChip}" Tag="{Binding KindKey}">
                                <TextBlock Style="{StaticResource KindChipText}" Text="{Binding KindText}" />
                            </Border>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PostedText}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>
                        <v:FocusCardText Item="{Binding}" />
                        <!-- references only while expanded (FR.23.29) -->
                        <ContentControl Content="{Binding}" Style="{StaticResource ClosedRefs}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid v:LineSpacing.Factor="{DynamicResource LineSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The header row (FR.6.23): the session's identity (Delete, name, Running / Idle) and star on the left, "Send answers (n)" and Session at the right end. Margins and sizes are those of
             the Session view header's first row (16,10,16,8: the 8 px at the bottom are the padding above the first card), so the two rows line up. Always visible at the top, so it never scrolls away.
             The identity and the star are bound to the session pane (the Session property); everything else to the Focus view model. -->
        <DockPanel Grid.Row="0" x:Name="HeaderRow" Margin="16,10,16,8">
            <!-- The Session button (FR.6.23.7): the counterpart of the Focus button of the Session view header; a plain button, it never takes the keyboard focus. -->
            <Button DockPanel.Dock="Right" x:Name="SessionButton" Margin="8,0,0,0" Padding="10,6" VerticalAlignment="Center" Focusable="False"
                    Command="{Binding Session.BringSessionForwardCommand, ElementName=Panel}" AutomationProperties.Name="Session"
                    ToolTip="{Binding Session.Hints.SessionToolTip, ElementName=Panel}" Content="Session" />
            <!-- "Send answers (n)" (FR.23.21 amended): same enabling rule, Ctrl+Enter in a reply box unchanged (FR.23.22). -->
            <Button DockPanel.Dock="Right" x:Name="SendAnswersButton" Command="{Binding SendAnswersCommand}" Margin="8,0,0,0" Padding="10,6" VerticalAlignment="Center"
                    Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="Send answers"
                    ToolTip="Send every filled reply box in one prompt (Ctrl+Enter in a reply box)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="{StaticResource GlyphSend}" />
                    <TextBlock Text="{Binding SendAnswersText}" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <v:FavoriteButton x:Name="HeaderStar" DockPanel.Dock="Right" DataContext="{Binding Session, ElementName=Panel}" />
            <v:SessionIdentity x:Name="HeaderIdentity" DataContext="{Binding Session, ElementName=Panel}" />
        </DockPanel>
        <TextBlock Grid.Row="1" Text="{Binding Error}" TextWrapping="Wrap" Margin="12,0,12,8" Foreground="{DynamicResource SystemFillColorCriticalBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,0,12,12">
                <TextBlock x:Name="NoSessionText" Text="Open a session to see what needs your attention." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSession}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock x:Name="NothingOpenText" Text="Nothing needs your attention in this session." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSession}" Value="True" />
                                        <Condition Binding="{Binding IsEmpty}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding OpenItems}" ItemTemplate="{StaticResource OpenCardTemplate}" Focusable="False" />

                <Expander Header="{Binding DecisionsHeader}" IsExpanded="{Binding IsDecisionsExpanded, Mode=TwoWay}" Margin="0,4,0,0" AutomationProperties.AutomationId="FocusDecisionsExpander"
                          Visibility="{Binding HasDecisions, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding DecidedItems}" ItemTemplate="{StaticResource OpenCardTemplate}" Focusable="False" Margin="0,8,0,0" />
                </Expander>

                <Expander Header="{Binding ClosedHeader}" IsExpanded="{Binding IsClosedExpanded, Mode=TwoWay}" Margin="0,4,0,0" AutomationProperties.AutomationId="FocusClosedExpander"
                          Visibility="{Binding HasClosed, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding ClosedItems}" ItemTemplate="{StaticResource ClosedCardTemplate}" Focusable="False" Margin="0,8,0,0" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
