<UserControl x:Class="TessynDesktop.WPF.Views.FocusPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TessynDesktop.WPF.ViewModels"
             xmlns:v="clr-namespace:TessynDesktop.WPF.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Kind chip: colours come from the Fluent theme brushes so light and dark both work. -->
            <Style x:Key="KindChip" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,1" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding KindKey}" Value="critical">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding KindKey}" Value="ask">
                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding KindKey}" Value="todo">
                        <Setter Property="Background" Value="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding KindKey}" Value="alert">
                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="KindChipText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding KindKey}" Value="critical">
                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding KindKey}" Value="ask">
                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding KindKey}" Value="todo">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding KindKey}" Value="alert">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RefGlyph" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Text" Value="{StaticResource GlyphLink}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="entry">
                        <Setter Property="Text" Value="{StaticResource GlyphEntry}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="file">
                        <Setter Property="Text" Value="{StaticResource GlyphFile}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding KindKey}" Value="critical">
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title. "Send answers (n)" lives in the session header (FR.23.14). -->
        <DockPanel Grid.Row="0" Margin="12,10,12,8">
            <TextBlock Text="Focus" Style="{DynamicResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding Error}" TextWrapping="Wrap" Margin="12,0,12,8" Foreground="{DynamicResource SystemFillColorCriticalBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,0,12,12">
                <TextBlock Text="Nothing needs your attention in this session." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FocusItemViewModel}">
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <!-- kind chip, item id, title -->
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Style="{StaticResource KindChip}" Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource KindChipText}" Text="{Binding KindText}" />
                                        </Border>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Id}" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <StackPanel Margin="0,8,0,0" v:MarkdownText.Source="{Binding Body}" Visibility="{Binding HasBody, Converter={StaticResource BoolToVis}}" />

                                    <!-- references (FR.23.18) -->
                                    <ItemsControl ItemsSource="{Binding Refs}" Margin="0,4,0,0" Visibility="{Binding HasRefs, Converter={StaticResource BoolToVis}}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:FocusRefViewModel}">
                                                <Button Command="{Binding OpenCommand}" ToolTip="{Binding ToolTip}" Margin="0,0,6,6" Padding="8,3" AutomationProperties.Name="{Binding Label}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource RefGlyph}" />

                                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- options and recommendation -->
                                    <ItemsControl ItemsSource="{Binding Options}" Margin="0,4,0,0" Visibility="{Binding HasOptions, Converter={StaticResource BoolToVis}}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:FocusOptionViewModel}">
                                                <Button Command="{Binding PickCommand}" Margin="0,0,6,6" Padding="10,4" Content="{Binding Text}" ToolTip="Use this as your answer" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Command="{Binding AcceptRecommendationCommand}" HorizontalAlignment="Left" Margin="0,0,0,6" Padding="10,4"
                                            Visibility="{Binding HasRecommendation, Converter={StaticResource BoolToVis}}" ToolTip="Answer with the recommendation">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0" Text="{StaticResource GlyphCheck}" />
                                            <TextBlock Text="{Binding Recommendation, StringFormat=Recommended: {0}}" TextWrapping="Wrap" MaxWidth="280" />
                                        </StackPanel>
                                    </Button>

                                    <!-- free-text answer -->
                                    <TextBox Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="160"
                                             VerticalScrollBarVisibility="Auto" ToolTip="Your answer; sent with Reply or Send answers" AutomationProperties.Name="Your answer" />
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Command="{Binding DismissCommand}" Content="{Binding CloseText}" ToolTip="Closes the item without sending anything" />
                                        <Button HorizontalAlignment="Left" Command="{Binding ReplyCommand}" Content="Reply" Style="{DynamicResource AccentButtonStyle}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
