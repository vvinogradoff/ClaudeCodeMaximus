<UserControl x:Class="TessynDesktop.WPF.Views.InstructionToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The instruction toggles above the prompt box (W4, FR.11.1). The slot's DataContext is the SessionPaneViewModel; this row binds to its Instruction. -->
    <StackPanel DataContext="{Binding Instruction}" Margin="0,0,0,6">
        <StackPanel Orientation="Horizontal">
            <StackPanel.Resources>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="Padding" Value="10,3" />
                </Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="Padding" Value="10,3" />
                </Style>
            </StackPanel.Resources>
            <!-- Tri-state: a button that cycles, not a toggle. Commit shows in the accent colour, Do-not-commit in the caution colour, No preference plain. -->
            <Button Content="{Binding AutoCommitLabel}" ToolTip="{Binding AutoCommitTip}" Command="{Binding CycleAutoCommitCommand}"
                    AutomationProperties.Name="Auto-Commit" AutomationProperties.HelpText="{Binding AutoCommitLabel}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Margin" Value="0,0,6,0" />
                        <Setter Property="Padding" Value="10,3" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AutoCommitIsCommit}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding AutoCommitIsDoNot}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <ToggleButton Content="New branch" IsEnabled="{Binding IsToolbarEnabled}" IsChecked="{Binding NewBranchChecked, Mode=TwoWay}"
                          ToolTip="New Branch: ask for a new git branch before committing. Applies to the next send only." AutomationProperties.Name="New Branch" />
            <ToggleButton Content="Document" IsEnabled="{Binding IsToolbarEnabled}" IsChecked="{Binding AutoDocumentChecked, Mode=TwoWay}"
                          ToolTip="Auto-Document: update the requirements and architecture documents after the request." AutomationProperties.Name="Auto-Document" />
            <ToggleButton Content="Compact" IsEnabled="{Binding IsToolbarEnabled}" IsChecked="{Binding AutoCompactChecked, Mode=TwoWay}"
                          ToolTip="Auto-Compact: compact the session after the next send. With an empty prompt, Send only compacts." AutomationProperties.Name="Auto-Compact" />
            <Button Content="Compact now" Command="{Binding CompactCommand}" ToolTip="Compact the session now, without a turn." AutomationProperties.Name="Compact now" />
            <Button Content="Terminate" Command="{Binding ClearCommand}" ToolTip="Detach the Claude session; the next prompt continues from the text history." AutomationProperties.Name="Terminate session" />
        </StackPanel>
        <TextBlock Text="{Binding Notice}" Margin="2,4,0,0" TextWrapping="Wrap" AutomationProperties.Name="Instruction notice" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
