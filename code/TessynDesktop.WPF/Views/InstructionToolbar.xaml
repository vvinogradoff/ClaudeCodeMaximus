<UserControl x:Class="TessynDesktop.WPF.Views.InstructionToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <!-- The instruction buttons of the title bar (W4, FR.11.1; moved here from above the prompt box, as in the Avalonia title bar). The slot's DataContext is
         the MainViewModel; this row binds to the open session's Instruction. Icon buttons: the text is in the tooltip and the automation name. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/TitleBarButtons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" DataContext="{Binding Session.Instruction}" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <!-- Tri-state: a button that cycles, not a toggle. Commit shows in the success colour, Do-not-commit in the caution colour, No preference plain. -->
        <Button Content="&#x2013;" ToolTip="{Binding AutoCommitTip}" Command="{Binding CycleAutoCommitCommand}"
                AutomationProperties.Name="Auto-Commit" AutomationProperties.HelpText="{Binding AutoCommitLabel}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource BarIconButton}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AutoCommitIsCommit}" Value="True">
                            <Setter Property="Content" Value="&#x2713;" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AutoCommitIsDoNot}" Value="True">
                            <Setter Property="Content" Value="&#x2298;" />
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <ToggleButton Style="{StaticResource BarIconToggle}" Content="&#x2442;" IsEnabled="{Binding IsToolbarEnabled}" IsChecked="{Binding NewBranchChecked, Mode=TwoWay}"
                      ToolTip="New Branch: ask for a new git branch before committing. Applies to the next send only." AutomationProperties.Name="New Branch" />
        <ToggleButton Style="{StaticResource BarIconToggle}" Content="&#x270E;" IsEnabled="{Binding IsToolbarEnabled}" IsChecked="{Binding AutoDocumentChecked, Mode=TwoWay}"
                      ToolTip="Auto-Document: update the requirements and architecture documents after the request." AutomationProperties.Name="Auto-Document" />
        <ToggleButton Style="{StaticResource BarIconToggle}" Content="&#x29C9;" IsEnabled="{Binding IsToolbarEnabled}" IsChecked="{Binding AutoCompactChecked, Mode=TwoWay}"
                      ToolTip="Auto-Compact: compact the session after the next send. With an empty prompt, Send only compacts." AutomationProperties.Name="Auto-Compact" />
        <Button Style="{StaticResource BarIconButton}" Content="&#x21F2;" Command="{Binding CompactCommand}" ToolTip="Compact the session now, without a turn." AutomationProperties.Name="Compact now" />
        <Button Style="{StaticResource BarIconButton}" Content="&#x2672;" Command="{Binding ClearCommand}" ToolTip="Terminate session: detach the Claude session; the next prompt continues from the text history." AutomationProperties.Name="Terminate session" />
        <TextBlock Text="{Binding Notice}" Margin="6,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11" ToolTip="{Binding Notice}"
                   AutomationProperties.Name="Instruction notice" Foreground="{DynamicResource TitleBarSubtleBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
