<UserControl x:Class="TessynDesktop.WPF.Views.ComposerNotices"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:TessynDesktop.WPF">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/Icons.xaml" /></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Notices above the prompt box (W1b). The DataContext is the SessionPaneViewModel of the slot's host. -->
    <StackPanel>
        <!-- The session's profile is signed out (the daemon's authError flag) -->
        <Border x:Name="AuthNotice" Margin="0,0,0,6" Padding="10,6" CornerRadius="4" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                Visibility="{Binding HasAuthError, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Sign-in needed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding ReauthenticateCommand}" Content="{Binding ReauthenticateLabel}" Padding="10,2" Margin="8,0,0,0"
                        ToolTip="Sign this session's profile in again" AutomationProperties.Name="{Binding ReauthenticateLabel}" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" Text="{StaticResource GlyphWarning}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Static l:Constants+ComposerTexts.AuthErrorMessage}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding AuthNotice}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AuthNotice}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Suggestions wait for the daemon's code index -->
        <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static l:Constants+ComposerTexts.IndexBuilding}"
                   Visibility="{Binding Autocomplete.IsIndexBuilding, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Code index building" />
    </StackPanel>
</UserControl>
