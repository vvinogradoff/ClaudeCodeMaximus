<UserControl x:Class="TessynDesktop.WPF.Views.ScreensaverOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="False">
    <!-- Covers the whole window while the screensaver runs; any input on it ends the screensaver. -->
    <Grid Background="Black">
        <Image x:Name="Picture" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
    </Grid>
</UserControl>
