<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:vm="clr-namespace:TessynDesktop.WPF.ViewModels"
                    xmlns:v="clr-namespace:TessynDesktop.WPF.Views">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/Icons.xaml" />
        <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/TreeRowStyles.xaml" />
        <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/KindPill.xaml" />
        <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/RecencyTint.xaml" />
        <ResourceDictionary Source="/TessynDesktop.WPF;component/Styles/ActiveWorkersBadge.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <sys:String x:Key="GlyphStar">&#xE734;</sys:String>
    <sys:String x:Key="GlyphStarFilled">&#xE735;</sys:String>
    <sys:String x:Key="GlyphHide">&#xE8F8;</sys:String>
    <sys:String x:Key="GlyphEdit">&#xE70F;</sys:String>
    <sys:String x:Key="GlyphFolder">&#xE8B7;</sys:String>
    <sys:String x:Key="GlyphClock">&#xE823;</sys:String>
    <BooleanToVisibilityConverter x:Key="SessionListBoolToVis" />

    <!-- A flat icon button used by the icon slot of a row. -->
    <Style x:Key="RowIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <!-- A virtualising list of flattened group headers and session rows: no selection chrome, rows are buttons. -->
    <Style x:Key="SessionFlatListBox" TargetType="ListBox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The collapsible directory header of a grouped list. -->
    <DataTemplate DataType="{x:Type vm:SessionGroupHeaderViewModel}">
        <Button Command="{Binding ToggleCommand}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="6,5"
                HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding AutomationName}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ChevronGlyph}" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" FontSize="12" Margin="2,0,6,0" Text="{StaticResource GlyphFolder}" />
                <TextBlock DockPanel.Dock="Right" Margin="6,0,0,0" Text="{Binding Count}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Button>
    </DataTemplate>

    <!-- A row button without Fluent button chrome: no accent fill on press or while a popup is open, only a faint hover overlay over the row's own recency colour. -->
    <Style x:Key="FlatRowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Border x:Name="Hover" CornerRadius="3" Margin="2,1" IsHitTestVisible="False" Visibility="Collapsed" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Opacity="0.6" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The icon slot of a row (FR.9.7): one of star (favourite), Hide, star to set. Laid over the right end of the row, whose face keeps that room free. -->
    <DataTemplate x:Key="RowIconSlot" DataType="{x:Type vm:SessionRowViewModel}">
        <Grid Width="26">
            <Button Style="{StaticResource RowIconButton}" Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding}" ToolTip="Favourite"
                    Visibility="{Binding ShowStar, Converter={StaticResource SessionListBoolToVis}}" AutomationProperties.Name="{Binding FavoriteAutomationName}">
                <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphStarFilled}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            </Button>
            <Button Style="{StaticResource RowIconButton}" Command="{Binding HideCommand}" CommandParameter="{Binding}" ToolTip="Hide from Recent"
                    Visibility="{Binding ShowHide, Converter={StaticResource SessionListBoolToVis}}" AutomationProperties.Name="{Binding HideAutomationName}">
                <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphHide}" />
            </Button>
            <Button Style="{StaticResource RowIconButton}" Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding}" ToolTip="Make a favourite"
                    Visibility="{Binding ShowStarToggle, Converter={StaticResource SessionListBoolToVis}}" AutomationProperties.Name="{Binding FavoriteAutomationName}">
                <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{StaticResource GlyphStar}" />
            </Button>
        </Grid>
    </DataTemplate>

    <!-- One session row of the Recent and Tags tabs (FR.1.16, FR.9.7): the shared row face over the whole width of the list (so the recency colour spans it), the icon slot laid over its right end.
         The group header above shows the project, so the row does not. -->
    <DataTemplate DataType="{x:Type vm:SessionRowViewModel}">
        <Grid Margin="0,1">
            <Button Command="{Binding OpenCommand}" CommandParameter="{Binding}" Tag="open" Style="{StaticResource FlatRowButton}" AutomationProperties.Name="{Binding OpenAutomationName}">
                <v:SessionRowFace ReservedRight="26" />
            </Button>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowIconSlot}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,4,0" />
        </Grid>
    </DataTemplate>

    <!-- One session row of the title-bar Recent dropdown, as the Avalonia dropdown: one line across the whole width (status squares, Focus pill, the session name taking the space), then the
         project name above the profile at the far right, the schedule clock and the icon slot. -->
    <DataTemplate x:Key="DropdownRowTemplate" DataType="{x:Type vm:SessionRowViewModel}">
        <Grid Margin="0,1">
            <Button Command="{Binding OpenCommand}" CommandParameter="{Binding}" Tag="open" Style="{StaticResource FlatRowButton}" AutomationProperties.Name="{Binding OpenAutomationName}">
                <Border Style="{StaticResource RecencyTint}" MinHeight="30">
                    <Grid>
                        <Grid Margin="2,1,30,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="8" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" AutomationProperties.Name="Session status">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="8" />
                                </Grid.RowDefinitions>
                                <Rectangle Grid.Row="0" Width="8" Height="8" Fill="{DynamicResource Colour.StatusRunning}" Visibility="{Binding IsRunning, Converter={StaticResource SessionListBoolToVis}}" />
                                <Rectangle Grid.Row="1" Width="8" Height="8" Fill="{DynamicResource Colour.StatusResumable}" Opacity="0.7" Visibility="{Binding IsResumable, Converter={StaticResource SessionListBoolToVis}}" />
                            </Grid>
                            <Border Grid.Column="1" Style="{StaticResource KindPill}" Tag="{Binding AttentionKey}" Margin="0,0,6,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasAttention, Converter={StaticResource SessionListBoolToVis}}" AutomationProperties.Name="Focus items">
                                <TextBlock Text="{Binding AttentionCount}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="3" Style="{StaticResource ActiveWorkersBadge}" Margin="6,0,0,0" AutomationProperties.Name="Active workers">
                                <TextBlock Style="{StaticResource ActiveWorkersBadgeText}" />
                            </Border>
                            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                                <TextBlock Text="{Binding DirectoryLabel}" HorizontalAlignment="Right" FontSize="10" Opacity="0.6" MaxWidth="140" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Project" />
                                <TextBlock Text="{Binding ProfileName}" HorizontalAlignment="Right" FontSize="10" Opacity="0.6" MaxWidth="140" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Profile" />
                            </StackPanel>
                            <TextBlock Grid.Column="5" Style="{StaticResource IconText}" FontSize="10" Margin="6,0,0,0" Text="{StaticResource GlyphClock}" Opacity="0.7" ToolTip="This session has a schedule"
                                       Visibility="{Binding HasSchedules, Converter={StaticResource SessionListBoolToVis}}" AutomationProperties.Name="Schedule indicator" />
                        </Grid>
                        <Rectangle Stroke="{DynamicResource Colour.ActiveBorder}" StrokeThickness="1" StrokeDashArray="3,2" RadiusX="3" RadiusY="3" Fill="Transparent" IsHitTestVisible="False"
                                   Visibility="{Binding IsRecentlyActive, Converter={StaticResource SessionListBoolToVis}}" />
                    </Grid>
                </Border>
            </Button>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowIconSlot}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
        </Grid>
    </DataTemplate></ResourceDictionary>
