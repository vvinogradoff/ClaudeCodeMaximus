<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The colours the app adds to Fluent's own dark theme: title bar, usage meters, screensaver. -->
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="TitleBarSubtleBrush" Color="#ADADAD" />
    <SolidColorBrush x:Key="MeterTrackBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="MeterFillBrush" Color="#7A7A7A" />
    <SolidColorBrush x:Key="MeterHotBrush" Color="#C9722F" />
    <SolidColorBrush x:Key="MeterTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#2B2B2B" />
</ResourceDictionary>
