<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ad="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
                    xmlns:reskeys="clr-namespace:AvalonDock.Themes.VS2013.Themes;assembly=AvalonDock.Themes.VS2013"
                    xmlns:menukeys="clr-namespace:AvalonDock.Themes.VS2013.Themes.Menu;assembly=AvalonDock.Themes.VS2013">
	<!-- The docking chrome's dark colours (FR.6.21): every brush key AvalonDock's VS2013 templates look up (the templates are loaded without the library's own brushes, see
	     TessynDockTheme), in Tessyn's palette. Merged by Theme.Dark.xaml, so the day/night switch recolours the whole docking chrome by swapping that one dictionary
	     (every window, also the slide-out, the drop guides and the floating windows, reads these from the application resources). Row = the tab row and the splitters, content = the
	     selected tab and the panel body, stroke = borders and the idle auto-hide edge tab, hover = the hovered tab. The selected tab's accent line is the system accent, drawn by the tab template. -->
	<Color x:Key="{x:Static reskeys:ResourceKeys.ControlAccentColorKey}">#60CDFF</Color>
	<SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabButtonSelectedActivePressedBackground}" Color="#26FFFFFF" />
	<SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowCaptionButtonInactivePressedBackground}" Color="#26FFFFFF" />
	<SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowTabUnselectedBackground}" Color="#2B2B2B" />
	<SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.TabBackground}" Color="#2B2B2B" />
	<SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.NavigatorWindowForeground}" Color="#FFFFFF" />
	<SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabSelectedInactiveBackground}" Color="#202020" />
	<SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DockingButtonStarBorderBrushKey}" Color="#3C3C3C" />
	<SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabSelectedInactiveText}" Color="#FFFFFF" />
	<SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabUnselectedHoveredBackground}" Color="#1AFFFFFF" />
	<SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowCaptionActiveBackground}" Color="#2B2B2B" />
	<SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.AutoHideTabHoveredBorder}" Color="#60CDFF" />
	<SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowCaptionButtonInactivePressedBorder}" Color="#3C3C3C" />
	<SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabButtonSelectedActivePressedGlyph}" Color="#FFFFFF" />
	<SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabButtonUnselectedTabHoveredButtonHoveredBorder}" Color="#3C3C3C" />
