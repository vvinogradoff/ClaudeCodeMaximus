<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ad="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
                    xmlns:reskeys="clr-namespace:AvalonDock.Themes.VS2013.Themes;assembly=AvalonDock.Themes.VS2013">
	<!-- The docking chrome's light colours (FR.6.21): every brush key AvalonDock's VS2013 templates look up (the templates are loaded without the library's own brushes, see
	     TessynDockTheme), in Tessyn's palette. Merged by Theme.Light.xaml, so the day/night switch recolours the whole docking chrome by swapping that one dictionary
	     (every window, also the slide-out, the drop guides and the floating windows, reads these from the application resources). Row = the tab row and the splitters, content = the
	     selected tab and the panel body, stroke = borders and the idle auto-hide edge tab, hover = the hovered tab. The selected tab's accent line is the system accent, drawn by the tab template. -->
	<Color x:Key="{x:Static reskeys:ResourceKeys.ControlAccentColorKey}">#005FB8</Color>
	<SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.DocumentWellTabButtonSelectedActivePressedBackground}" Color="#26000000" />
