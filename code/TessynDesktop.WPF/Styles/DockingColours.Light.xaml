	<SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.ToolWindowTabUnselectedBackground}" Color="#E9E9E9" />
	<SolidColorBrush x:Key="{x:Static reskeys:ResourceKeys.TabBackground}" Color="#E9E9E9" />
