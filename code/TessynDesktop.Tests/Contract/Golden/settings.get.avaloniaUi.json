{
  "section": "avalonia-ui",
  "version": 1,
  "values": {
    "theme": "Light",
    "assistantFontSize": 13,
    "assistantMarkdownFontSize": 13,
    "userFontSize": 13,
    "inputFontSize": 13,
    "lightColors": {
      "inputBoxBackground": "#FFFFFF",
      "inputBoxText": "#000000",
      "userBubbleBackground": "#1E3A5F",
      "userBubbleText": "#FFFFFF",
      "codeBlockBackground": "#F5F5F5",
      "codeBlockText": "#202020",
      "inlineCodeBackground": "#E8E8E8",
      "inlineCodeText": "#202020",
      "systemBubbleBackground": "#BFE0F7",
      "recency15MinBackground": "#90EE90",
      "recency30MinBackground": "#3CB371",
      "recency60MinBackground": "#2E8B57"
    },
    "darkColors": {
      "inputBoxBackground": "#1E1E1E",
      "inputBoxText": "#D4D4D4",
      "userBubbleBackground": "#1E3A5F",
      "userBubbleText": "#FFFFFF",
      "codeBlockBackground": "#2D2D2D",
      "codeBlockText": "#D4D4D4",
      "inlineCodeBackground": "#252525",
      "inlineCodeText": "#D4D4D4",
      "systemBubbleBackground": "#1A3A50",
      "recency15MinBackground": "#2D5A3D",
      "recency30MinBackground": "#1E4D2B",
      "recency60MinBackground": "#15381F"
    },
    "keyBindings": [
      {
        "action": "AddDirectory",
        "binding": "Ctrl+O"
      },
      {
        "action": "CloseDialog",
        "binding": "Escape, Ctrl+W"
      },
      {
        "action": "ImportSessions",
        "binding": "Ctrl+I"
      },
      {
        "action": "OpenSettings",
        "binding": "Ctrl+OemComma"
      },
      {
        "action": "Send",
        "binding": "Ctrl+Enter, Shift+Enter"
      }
    ],
    "screensaver": {
      "directory": "<root>/pictures",
      "timeoutSeconds": 120,
      "slideshowIntervalSeconds": 10
    }
  }
}
