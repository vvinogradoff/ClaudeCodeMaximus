{
  "TessynWeb": {
    "Auth": {
      "Email": "REPLACE_WITH_LOGIN_EMAIL",
      "PasswordHash": "REPLACE_WITH_OUTPUT_OF: echo -n 'password' | ./Tessyn.Web hash-password",
      "CookieDays": 14,
      "AbsoluteDays": 30
    },
    "Link": {
      "TokenSha256": "REPLACE_WITH_SHA256_HEX_FROM: ./Tessyn.Web new-link-token"
    },
    "DataProtectionKeysPath": "/var/lib/tessyn-web/keys"
  }
}
